@using Inventory.Web.ViewModels.Accounts
@model ChangePasswordVM

@{
    ViewData["Title"] = Localizer["Change Password"];
}

<div class="row justify-content-center my-4">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow-sm border rounded-4 overflow-hidden auth-card">

            <!-- Card Header -->
            <div class="card-header bg-primary bg-opacity-10 border-bottom p-4 text-center">
                <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2 shadow-sm" style="width: 48px; height: 48px;">
                    <i class="bi bi-key-fill fs-4"></i>
                </div>
                <h4 class="fw-bold header-title mb-1">@Localizer["Change Password"]</h4>
                <small class="header-subtitle">@Localizer["Enter current and new password details"]</small>
            </div>

            <!-- Card Body -->
            <div class="card-body p-4">
                <form id="changePasswordForm" asp-controller="Accounts" asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Email" />

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <!-- Current Password -->
                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-semibold small">@Localizer["Current Password"]</label>
                        <div class="input-group">
                            <span class="input-group-text bg-body-secondary text-muted border-end-0 rounded-start-pill ps-3">
                                <i class="bi bi-lock"></i>
                            </span>
                            <input asp-for="CurrentPassword" type="password" id="currentPasswordInput" class="form-control border-start-0 border-end-0 px-3 shadow-none password-field" placeholder="••••••••" autocomplete="current-password" />
                            <button type="button" class="btn btn-outline-secondary border-start-0 bg-transparent rounded-end-pill pe-3 toggle-password-btn text-muted shadow-none" data-target="#currentPasswordInput" aria-label="@Localizer["Toggle password visibility"]" tabindex="-1">
                                <i class="bi bi-eye-slash"></i>
                            </button>
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- New Password -->
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold small">@Localizer["New Password"]</label>
                        <div class="input-group">
                            <span class="input-group-text bg-body-secondary text-muted border-end-0 rounded-start-pill ps-3">
                                <i class="bi bi-shield-lock"></i>
                            </span>
                            <input asp-for="NewPassword" type="password" id="newPasswordInput" class="form-control border-start-0 border-end-0 px-3 shadow-none password-field" placeholder="••••••••" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary border-start-0 bg-transparent rounded-end-pill pe-3 toggle-password-btn text-muted shadow-none" data-target="#newPasswordInput" aria-label="@Localizer["Toggle password visibility"]" tabindex="-1">
                                <i class="bi bi-eye-slash"></i>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Confirm Password -->
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold small">@Localizer["Confirm Password"]</label>
                        <div class="input-group">
                            <span class="input-group-text bg-body-secondary text-muted border-end-0 rounded-start-pill ps-3">
                                <i class="bi bi-check-circle"></i>
                            </span>
                            <input asp-for="ConfirmPassword" type="password" id="confirmPasswordInput" class="form-control border-start-0 border-end-0 px-3 shadow-none password-field" placeholder="••••••••" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary border-start-0 bg-transparent rounded-end-pill pe-3 toggle-password-btn text-muted shadow-none" data-target="#confirmPasswordInput" aria-label="@Localizer["Toggle password visibility"]" tabindex="-1">
                                <i class="bi bi-eye-slash"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top gap-2">
                        <button type="button" onclick="history.back()" class="btn btn-action-back rounded-pill px-4 shadow-sm fw-semibold">
                            <i class="bi bi-arrow-left me-1"></i> @Localizer["Cancel"]
                        </button>
                        <button type="submit" id="btnSubmitPassword" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
                            <span id="btnSubmitSpinner" class="spinner-border spinner-border-sm me-1 d-none" role="status" aria-hidden="true"></span>
                            <i class="bi bi-shield-check me-1" id="btnSubmitIcon"></i>
                            <span id="btnSubmitText">@Localizer["Update Password"]</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Account/ChangePassword.js" asp-append-version="true"></script>
}