@using Inventory.Web.ViewModels.Accounts
@model IEnumerable<UsersVM>

@{
    ViewData["Title"] = "Users List";
    const string DefaultAvatar = "/images/Portrait_Placeholder.png";
}

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-dark"><i class="bi bi-people-fill me-2 text-primary"></i>@Localizer["Users List"]</h2>
    <a asp-action="Register" class="btn btn-primary rounded-pill px-4 shadow-sm">
        <i class="bi bi-person-plus-fill me-1"></i> @Localizer["Add New User"]
    </a>
</div>

<div class="card border-0 shadow-sm ">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="usersTable">
            <thead class="table-light">
                <tr>
                    <th class="ps-4" style="width: 70px;">@Localizer["Avatar"]</th>
                    <th>@Localizer["User Info"]</th>
                    <th>@Localizer["Email"]</th>
                    <th>@Localizer["Role"]</th>
                    <th class="text-end pe-4" style="width: 280px;">@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var user in Model)
                    {
                        var avatarUrl = string.IsNullOrEmpty(user.Img) ? DefaultAvatar : user.Img;
                        <tr id="user-row-@user.Id">
                            <td class="ps-4">
                                <a href="javascript:void(0)" onclick="showFullImage(@Html.Raw(Json.Serialize(avatarUrl)), @Html.Raw(Json.Serialize(user.UserName)))">
                                    <img src="@avatarUrl"
                                         class="rounded-circle object-fit-cover border shadow-sm"
                                         style="width: 44px; height: 44px; cursor: pointer;"
                                         alt="@user.UserName" />
                                </a>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@user.UserName</div>
                                <small class="text-muted">@user.NameEn / @user.NameAr</small>
                            </td>
                            <td class="text-secondary small">@user.Email</td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 fs-7 fw-semibold">
                                    @user.RoleName
                                </span>
                            </td>
                            <td class="text-end pe-4 text-nowrap">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="PersonalData" asp-route-id="@user.Id" class="btn btn-sm btn-outline-info text-nowrap">
                                        <i class="bi bi-pencil"></i> 
                                    </a>
                                    <a asp-action="ChangePassword" asp-route-id="@user.Id" class="btn btn-sm btn-outline-warning text-nowrap mx-1">
                                        <i class="bi bi-key"></i> 
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger text-nowrap" onclick="deleteUser('@user.Id', @Html.Raw(Json.Serialize(user.UserName)))">
                                        <i class="bi bi-trash"></i> 
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr id="emptyRow">
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-person-x display-6 d-block mb-2 text-secondary"></i>
                            @Localizer["No users registered yet. Click"] <strong>@Localizer["Add New User"] </strong> @Localizer["to get started."]
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function deleteUser(id, userName) {
            Swal.fire({
                title: 'Delete User?',
                text: `Do you really want to delete user "${userName}"?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    const token = $('input[name="__RequestVerificationToken"]').val();

                    $.ajax({
                        url: `@Url.Action("Delete", "Accounts")/${id}`,
                        type: 'POST',
                        headers: { "RequestVerificationToken": token },
                        success: function(response) {
                            Swal.fire({
                                icon: response.icon || 'success',
                                title: response.title || 'Deleted!',
                                text: response.message || 'User deleted successfully.',
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => {
                                $(`#user-row-${id}`).fadeOut(300, function() {
                                    $(this).remove();

                                    // Render empty table state dynamically if no rows remain
                                    if ($('#usersTable tbody tr').length === 0) {
                                        const emptyHtml = `
                                                    <tr id="emptyRow">
                                                        <td colspan="5" class="text-center py-5 text-muted">
                                                            <i class="bi bi-person-x display-6 d-block mb-2 text-secondary"></i>
                                                            No users registered yet. Click <strong>Add New User</strong> to get started.
                                                        </td>
                                                    </tr>`;
                                        $('#usersTable tbody').html(emptyHtml);
                                    }
                                });
                            });
                        },
                        error: function(xhr) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: xhr.responseJSON?.message || 'An error occurred while attempting to delete the user.'
                            });
                        }
                    });
                }
            });
        }

        function showFullImage(imgUrl, userName) {
            Swal.fire({
                title: userName || 'User Avatar',
                imageUrl: imgUrl,
                imageWidth: 280,
                imageHeight: 280,
                showConfirmButton: false,
                showCloseButton: true,
                customClass: { image: 'rounded-circle object-fit-cover shadow' }
            });
        }
    </script>
}