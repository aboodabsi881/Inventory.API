@using Inventory.Web.ViewModels.Accounts
@model LoginVM

@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center align-items-center my-5">
    <div class="col-md-5">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 56px; height: 56px;">
                        <i class="bi bi-box-arrow-in-right fs-3"></i>
                    </div>
                    <h3 class="fw-bold text-dark">@Localizer["Welcome Back"]</h3>
                    <p class="text-muted small">@Localizer["Sign in to manage your inventory"]</p>
                </div>

                <form id="loginForm" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="UserName" class="form-control rounded-3" placeholder="@Localizer["User Name"] / @Localizer["Email"]" />
                        <label asp-for="UserName"></label>
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Password" type="password" class="form-control rounded-3" placeholder="@Localizer["Password"]" />
                        <label asp-for="Password"></label>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label text-muted small">@Localizer["Remember Me"]</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fw-semibold shadow-sm mb-3">
                        @Localizer["Sign In"]
                    </button>

                    <div class="text-center">
                        <span class="text-muted small">@Localizer["Don't have an account?"]</span>
                        <a asp-action="Register" class="text-primary text-decoration-none fw-bold small ms-1">@Localizer["Register Now"]</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $('#loginForm').on('submit', function (e) {
            e.preventDefault();

            const $form = $(this);
            if (!$form.valid()) return;

            // 💡 Use form.serialize() instead of FormData for clean ASP.NET Core Model Binding
            $.ajax({
                url: $form.attr('action') || '/Accounts/Login',
                type: 'POST',
                data: $form.serialize(),
                success: function (response) {
                    Swal.fire({
                        icon: response.icon || 'success',
                        title: Localizer["Welcome!"],
                        text: response.message || Localizer["Login successful!"],
                        timer: 1200,
                        showConfirmButton: false
                    }).then(() => {
                        // 💡 Full browser navigation to home page after setting authentication ticket
                        window.location.href = response.redirectUrl || '/Home/Index';
                    });
                },
                error: function (xhr) {
                    const err = xhr.responseJSON;
                    let errorMessage = 'Invalid login credentials.';

                    if (err && err.errors) {
                        errorMessage = Object.values(err.errors).flat().join('<br/>');
                    } else if (err && err.message) {
                        errorMessage = err.message;
                    }

                    Swal.fire({
                        icon: 'error',
                        title: 'Login Failed',
                        html: errorMessage
                    });
                }
            });
        });
    </script>
}