@using Inventory.Web.ViewModels.Accounts
@model LoginVM

@{
    ViewData["Title"] = Localizer["Sign In"];
}

<div class="auth-page-wrapper d-flex align-items-center justify-content-center min-vh-100 ">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
                <!-- Card -->
                <div class="card auth-card border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="card-body p-4 p-sm-5">
                        <form id="loginForm" asp-action="Login" method="post" novalidate>
                            @Html.AntiForgeryToken()
                            
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small rounded-3 mb-4" role="alert"></div>

                            <div class="text-center mb-4">
                                <div class="auth-brand-icon mx-auto mb-3">
                                    <i class="bi bi-box-seam-fill"></i>
                                </div>
                                <h3 class="fw-bold text-main mb-1">@Localizer["Welcome Back"]</h3>
                                <p class="text-muted small mb-0">@Localizer["Sign in to manage your inventory"]</p>
                            </div>

                            <!-- Username / Email Field -->
                            <div class="form-floating mb-3">
                                <input asp-for="UserName" class="form-control rounded-3"  autocomplete="username" />
                                <label asp-for="UserName">@Localizer["User Name or Email"]</label>
                                <span asp-validation-for="UserName" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Password Field with Bi-Directional Eye Toggle -->
                            <div class="form-floating mb-3 position-relative auth-password-group">
                                <input asp-for="Password" type="password" id="passwordInput" class="form-control rounded-3 auth-password-input"  autocomplete="current-password" />
                                <label asp-for="Password">@Localizer["Password"]</label>
                                <button type="button" class="btn btn-link auth-toggle-btn text-muted text-decoration-none shadow-none" id="togglePassword" aria-label="@Localizer["Toggle password visibility"]" tabindex="-1">
                                    <i class="bi bi-eye-slash fs-5" id="toggleIcon"></i>
                                </button>
                                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Options: Remember Me & Forgot Password -->
                            <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
                                <div class="form-check m-0">
                                    <input asp-for="RememberMe" class="form-check-input rounded" />
                                    <label asp-for="RememberMe" class="form-check-label text-muted small user-select-none">
                                        @Localizer["Remember Me"]
                                    </label>
                                </div>
                                <a asp-action="ForgotPassword" class="auth-link small text-decoration-none">
                                    @Localizer["Forgot Password?"]
                                </a>
                            </div>

                            <!-- Submit Button -->
                            <button type="submit"  class="btn btn-primary w-100 rounded-pill py-2 fw-semibold shadow-sm mb-4">
                                <span id="">@Localizer["Sign In"]</span>
                            </button>

                            <!-- Footer Navigation -->
                            <div class="text-center">
                                <span class="text-muted small">@Localizer["Don't have an account?"]</span>
                                <a asp-action="Register" class="auth-link fw-bold small ms-1 me-1 text-decoration-none">@Localizer["Register Now"]</a>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Account/Login.js"></script>
}
