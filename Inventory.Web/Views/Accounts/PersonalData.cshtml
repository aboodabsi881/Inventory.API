@using Inventory.Web.ViewModels.Accounts
@model PersonalDataVM

@{
    ViewData["Title"] = "Personal Data";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white p-4">
                    <div class="d-flex align-items-center gap-3">
                        <img id="avatar-preview"
                             src="@(string.IsNullOrWhiteSpace(Model.Img) ? "/images/Portrait_Placeholder.png" : Model.Img)"
                             class="rounded-circle border border-3 border-white object-fit-cover shadow-sm"
                             style="width: 72px; height: 72px;"
                             alt="Avatar" />
                        <div>
                            <h4 class="fw-bold mb-0">@Model.UserName</h4>
                            <small class="text-white-50">@Localizer["Manage personal profile details & role"]</small>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form id="personalDataForm" asp-action="PersonalData" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Img" />

                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="UserName" class="form-label fw-semibold text-secondary small">@Localizer["User Name"]</label>
                                <input asp-for="UserName" class="form-control rounded-3" />
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold text-secondary small">@Localizer["Email"]</label>
                                <input asp-for="Email" class="form-control rounded-3" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="NameEn" class="form-label fw-semibold text-secondary small">@Localizer["Name in English"]</label>
                                <input asp-for="NameEn" class="form-control rounded-3" />
                                <span asp-validation-for="NameEn" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="NameAr" class="form-label fw-semibold text-secondary small">@Localizer["Name in Arabic"]</label>
                                <input asp-for="NameAr" class="form-control rounded-3 text-end" dir="rtl" />
                                <span asp-validation-for="NameAr" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="RoleName" class="form-label fw-semibold text-secondary small">@Localizer["Role"]</label>
                                <select asp-for="RoleName" asp-items="Model.RoleLookup" class="form-select rounded-3">
                                    <option value="">@Localizer["-- Select Role --"]</option>
                                </select>
                                <span asp-validation-for="RoleName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ImgFile" class="form-label fw-semibold text-secondary small">@Localizer["Profile Image"]</label>
                                <input asp-for="ImgFile" type="file" accept="image/*" class="form-control rounded-3" id="img-input" />
                                <span asp-validation-for="ImgFile" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                                <i class="bi bi-arrow-left me-1"></i> @Localizer["Back to Users"]
                            </a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm fw-semibold">
                                <i class="bi bi-save me-1"></i> @Localizer["Save Changes"]
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Account/PersonalData.js"></script>
}
