@using Inventory.Web.ViewModels.Carts
@model IEnumerable<CartVM>

@{
    ViewData["Title"] = "Shopping Cart";
    decimal grandTotal = ViewBag.GrandTotal ?? 0;
}

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">
            <i class="bi bi-cart3 me-2"></i>@Localizer["Shopping Cart"]
        </h2>
        <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> @Localizer["Continue Shopping"]
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            <!-- Cart Items Table -->
            <div class="col-lg-8">
                <div class="card shadow-sm border-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="cartTable">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 40%;">@Localizer["Product"]</th>
                                    <th style="width: 15%;">@Localizer["Price"]</th>
                                    <th class="text-center" style="width: 20%;">@Localizer["Quantity"]</th>
                                    <th style="width: 15%;">@Localizer["Total"]</th>
                                    <th class="text-end" style="width: 10%;">@Localizer["Action"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    var imgUrl = string.IsNullOrEmpty(item.ProductImg) ? "/images/placeholder.png" : item.ProductImg;
                                    var calculatedTotal = item.TotalPrice > 0 ? item.TotalPrice : (item.Quantity * item.ProductPrice);

                                    <tr id="cart-row-@item.Id">
                                        <td style="width: 45%;">
                                            <div class="d-flex align-items-center">
                                                <a href="javascript:void(0)"
                                                   onclick="showFullImage('@imgUrl', '@item.ProductName')">
                                                    <img src="@imgUrl"
                                                         class="rounded me-3 object-fit-contain shadow-sm border bg-light"
                                                         style="width: 85px; height: 85px; min-width: 85px; cursor: pointer;"
                                                         alt="@item.ProductName"
                                                         title="@Localizer["Click to view full image"]" />
                                                </a>
                                                <div>
                                                    <h6 class="fw-bold mb-1 text-dark text-truncate" style="max-width: 250px;">
                                                        @(item.ProductName ?? Localizer["Unnamed Product"])
                                                    </h6>
                                                    <small class="text-muted">@Localizer["Click image to enlarge"]</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="fw-semibold text-secondary" id="price-@item.ProductId" data-price="@item.ProductPrice">
                                            $@item.ProductPrice.ToString("F2")
                                        </td>
                                        <td>
                                            <div class="input-group input-group-sm justify-content-center">
                                                <button type="button" class="btn btn-outline-secondary" onclick="updateQuantity(@item.ProductId, -1)">-</button>
                                                <span class="input-group-text bg-white px-3 fw-bold" id="qty-@item.ProductId">@item.Quantity</span>
                                                <button type="button" class="btn btn-outline-secondary" onclick="updateQuantity(@item.ProductId, 1)">+</button>
                                            </div>
                                        </td>
                                        <td class="fw-bold text-success" id="total-@item.ProductId">
                                            $@calculatedTotal.ToString("F2")
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeItem(@item.Id, '@item.ProductName')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Order Summary Sidebar -->
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 p-3">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">@Localizer["Order Summary"]</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">@Localizer["Subtotal"]</span>
                        <span class="fw-bold" id="summary-subtotal">$@grandTotal.ToString("F2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">@Localizer["Shipping"]</span>
                        <span class="text-success fw-bold">Free</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between mb-4 fs-5 fw-bold">
                        <span>@Localizer["Grand Total"]</span>
                        <span class="text-primary" id="summary-grandtotal">$@grandTotal.ToString("F2")</span>
                    </div>
                    <button type="button" class="btn btn-success w-100 btn-lg shadow-sm">
                        <i class="bi bi-credit-card me-2"></i> @Localizer["Proceed to Checkout"]
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-light text-center border shadow-sm p-5">
            <i class="bi bi-cart-x text-muted display-4 d-block mb-3"></i>
            <h4 class="fw-bold text-secondary">@Localizer["Your cart is empty"]</h4>
            <p class="text-muted">@Localizer["Looks like you haven't added anything to your cart yet."]</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary mt-2">
                @Localizer["Browse Products"]
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        window.CartConfig = {
            addOrUpdateUrl: '@Url.Action("AddOrUpdate", "Cart")',
            removeUrl: '@Url.Action("Remove", "Cart")',
            texts: {
                cartUpdated: @Json.Serialize(Localizer["Cart updated"].Value),
                cartError: @Json.Serialize(Localizer["Failed to update cart."].Value),
                removeTitle: @Json.Serialize(Localizer["Remove Item?"].Value),
                removeConfirm: @Json.Serialize(Localizer["Remove from your cart?"].Value),
                yesRemove: @Json.Serialize(Localizer["Yes, remove"].Value),
                removeError: @Json.Serialize(Localizer["Failed to remove item"].Value)
            }
        };
    </script>
    <script src="~/js/Cart/index.js"></script>
}