@using Inventory.Web.ViewModels.Categories
@model CreateUpdateCategoryVM

@{
    ViewData["Title"] = "Create Category";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-plus-lg me-2"></i>Create New Category</h4>
            </div>
            <div class="card-body">
                <form id="createCategoryForm" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="Enter category name..." />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ImgFile" class="form-label"></label>
                        <input asp-for="ImgFile" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="ImgFile" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg"></i> Save Category
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>









@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $('#createCategoryForm').on('submit', function(e) {
            e.preventDefault();

            // 1️⃣ التحقق من صحة المدخلات بجهة العميل
            if (!$(this).valid()) return;

            // 2️⃣ تعريف المتغيرات بشكل صحيح لمنع خطأ Uncaught ReferenceError
            const $form = $(this);
            const formData = new FormData(this); // 💡 FormData يحزم النصوص والملفات معاُ

            $.ajax({
                url: $form.attr('action') || '/Categories/Create',
                type: 'POST',
                data: formData,
                processData: false, // 👈 ضروري لرفع الملفات والصور
                contentType: false, // 👈 يمنع jQuery من إفساد نوع المحتوى
                success: function(response) {
                    Swal.fire({
                        icon: response.icon || 'success',
                        title: 'Success!',
                        text: response.message,
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => {
                        window.location.href = response.redirectUrl || '/Categories';
                    });
                },
                error: function(xhr) {
                    const err = xhr.responseJSON;
                    let errorMessage = 'Validation failed or server error.';

                    if (err && err.errors) {
                        errorMessage = Object.values(err.errors).flat().join('<br/>');
                    } else if (err && err.message) {
                        errorMessage = err.message;
                    }

                    Swal.fire({
                        icon: 'error',
                        title: 'Creation Failed',
                        html: errorMessage
                    });
                }
            });
        });
    </script>
}





