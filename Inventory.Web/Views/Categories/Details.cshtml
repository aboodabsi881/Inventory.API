@using Inventory.Web.ViewModels.Categories
@model CategoryDetailsVM

@{
    ViewData["Title"] = Localizer["Category Details"];
    var categoryImg = string.IsNullOrEmpty(Model.Img) ? "/images/placeholder.png" : Model.Img;
    var totalProducts = Model.ProductsVM?.Count ?? 0;
}

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<div class="container py-4">
    <!-- Category Banner Card -->
    <div class="card border shadow-sm rounded-4 overflow-hidden mb-5 cat-detail-card">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex flex-column flex-md-row align-items-center gap-4">

                <div class="category-banner-preview position-relative rounded-4 p-2 border shadow-sm flex-shrink-0 img-surface-wrap"
                     onclick="showLightbox('@categoryImg', '@Model.Name')"
                     style="cursor: pointer;">
                    <img src="@categoryImg"
                         class="img-fluid rounded-3 object-fit-contain"
                         style="width: 130px; height: 130px;"
                         alt="@Model.Name"
                         onerror="this.onerror=null; this.src='/images/placeholder.png';"
                         title="@Localizer["Click to enlarge"]" />
                    <span class="position-absolute bottom-0 end-0 rounded-circle p-1 m-1 shadow-sm text-muted small d-flex fav-floating-btn">
                        <i class="bi bi-arrows-fullscreen"></i>
                    </span>
                </div>

                <div class="text-center text-md-start flex-grow-1">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 mb-2 small fw-semibold">
                        <i class="bi bi-tag-fill me-1"></i> @Localizer["Category Overview"]
                    </span>
                    <h2 class="fw-bolder cat-heading mb-2">@Model.Name</h2>
                    <div class="d-inline-flex align-items-center rounded-pill px-3 py-1 small stat-pill-box">
                        <i class="bi bi-box-seam text-primary me-2"></i>
                        <span>@Localizer["Total Products"]: <strong class="stat-value">@totalProducts</strong></span>
                    </div>
                </div>

                <div class="d-flex gap-2 w-md-auto justify-content-center">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning rounded-pill px-4 shadow-sm fw-semibold">
                        <i class="bi bi-pencil me-1"></i> @Localizer["Edit"]
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-action-back rounded-pill px-4 shadow-sm">
                        <i class="bi bi-arrow-left me-1"></i> @Localizer["Back"]
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Products Sub-Section Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h4 class="fw-bold cat-heading mb-1 d-flex align-items-center">
                <i class="bi bi-grid-3x3-gap-fill text-primary me-2 fs-5"></i>
                @Localizer["Products in this Category"]
            </h4>
            <p class="cat-subtitle mb-0 small">@Localizer["Browse and manage products assigned under this group."]</p>
        </div>
    </div>

    <!-- Products Grid -->
    <div id="products-wrapper">
        @if (Model.ProductsVM != null && Model.ProductsVM.Any())
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4" id="products-container">
                @foreach (var product in Model.ProductsVM)
                {
                    var prodImg = string.IsNullOrEmpty(product.Img) ? "/images/placeholder.png" : product.Img;
                    var isOutOfStock = product.Quantity <= 0;
                    var isLowStock = product.Quantity > 0 && product.Quantity <= 5;

                    <div class="col" id="product-card-@product.Id">
                        <div class="card h-100 border shadow-sm rounded-4 overflow-hidden position-relative product-card cat-detail-card @(isOutOfStock ? "opacity-75" : "")">

                            <!-- Stock Status Badge (Top-Left) -->
                            <div class="position-absolute top-0 start-0 m-3" style="z-index: 5;">
                                @if (isOutOfStock)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1 small fw-semibold">
                                        <i class="bi bi-slash-circle me-1"></i>@Localizer["Out of Stock"]
                                    </span>
                                }
                                else if (isLowStock)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2 py-1 small fw-semibold">
                                        <i class="bi bi-exclamation-triangle me-1"></i>@Localizer["Low Stock"]: @product.Quantity
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 small fw-semibold">
                                        <i class="bi bi-check-circle me-1"></i>@Localizer["In Stock"]: @product.Quantity
                                    </span>
                                }
                            </div>

                            <!-- Favorite Action Button (Top-Right) -->
                            <button type="button"
                                    class="btn rounded-circle position-absolute top-0 end-0 m-3 shadow-sm border-0 d-flex align-items-center justify-content-center fav-floating-btn"
                                    id="fav-btn-@product.Id"
                                    onclick="toggleFavorite(@product.Id)"
                                    title="@Localizer["Toggle favorite"]"
                                    style="width: 36px; height: 36px; z-index: 5;">
                                <i class="bi @(product.IsFavorite ? "bi-heart-fill text-danger" : "bi-heart text-secondary") fs-6" id="fav-icon-@product.Id"></i>
                            </button>

                            <!-- Product Image -->
                            <div class="p-3 d-flex align-items-center justify-content-center position-relative product-img-wrap img-surface-wrap" style="height: 180px;">
                                <a href="javascript:void(0)"
                                   class="w-100 h-100 d-flex align-items-center justify-content-center text-decoration-none"
                                   onclick="showLightbox('@prodImg', '@product.Name')">
                                    <img src="@prodImg"
                                         class="img-fluid object-fit-contain h-100 w-100 product-img"
                                         alt="@product.Name"
                                         onerror="this.onerror=null; this.src='/images/placeholder.png';"
                                         title="@Localizer["Click to enlarge"]" />
                                </a>
                            </div>

                            <!-- Card Body -->
                            <div class="card-body d-flex flex-column p-3">
                                <h6 class="card-title fw-bold product-name-heading text-truncate mb-2" title="@product.Name">
                                    @product.Name
                                </h6>

                                <div class="d-flex align-items-baseline gap-1 mb-3">
                                    <span class="fs-5 fw-bolder text-primary" dir="ltr">$@product.Price.ToString("F2")</span>
                                </div>

                                <!-- Dynamic Cart Control Stepper -->
                                <div class="my-2" id="cart-control-container-@product.Id">
                                    @if (isOutOfStock)
                                    {
                                        <button type="button" class="btn btn-secondary w-100 rounded-pill py-2 shadow-sm fw-semibold disabled" disabled>
                                            <i class="bi bi-slash-circle me-1"></i>@Localizer["Unavailable"]
                                        </button>
                                    }
                                    else if (product.QuantityInCart > 0)
                                    {
                                        <div class="d-flex align-items-center justify-content-between bg-primary text-white rounded-pill px-2 py-1 shadow-sm" style="min-height: 38px;">
                                            <button type="button"
                                                    class="btn btn-sm text-white rounded-circle d-flex align-items-center justify-content-center p-0 border-0 bg-white bg-opacity-25 stepper-btn"
                                                    style="width: 28px; height: 28px;"
                                                    onclick="updateCartQuantity(@product.Id, -1)">
                                                <i class="bi bi-dash-lg"></i>
                                            </button>

                                            <span class="fw-bold px-1 fs-6 user-select-none text-truncate" id="card-qty-@product.Id">
                                                <span class="qty-num" dir="ltr">@product.QuantityInCart</span> <small class="fw-normal text-white-50 ms-1 small">@Localizer["in cart"]</small>
                                            </span>

                                            <button type="button"
                                                    class="btn btn-sm text-white rounded-circle d-flex align-items-center justify-content-center p-0 border-0 bg-white bg-opacity-25 stepper-btn @(product.QuantityInCart >= product.Quantity ? "disabled opacity-50" : "")"
                                                    style="width: 28px; height: 28px;"
                                                @(product.QuantityInCart >= product.Quantity ? "disabled" : "")
                                                    onclick="updateCartQuantity(@product.Id, 1)">
                                                <i class="bi bi-plus-lg"></i>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-outline-primary w-100 rounded-pill py-2 shadow-sm d-flex align-items-center justify-content-center gap-2 fw-semibold"
                                                onclick="updateCartQuantity(@product.Id, 1)">
                                            <i class="bi bi-bag-plus fs-6"></i>
                                            <span>@Localizer["Add to Cart"]</span>
                                        </button>
                                    }
                                </div>

                                <div class="mt-auto pt-3 border-top">
                                    <a asp-controller="Products"
                                       asp-action="Details"
                                       asp-route-id="@product.Id"
                                       asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                                       class="btn btn-action-view btn-view-details rounded-pill btn-sm w-100 fw-semibold">
                                        <i class="bi bi-info-circle me-1"></i> @Localizer["Details"]
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card border shadow-sm rounded-4 p-5 text-center my-3 cat-detail-card">
                <div class="py-3">
                    <div class="bg-secondary-subtle text-secondary rounded-circle d-inline-flex p-3 mb-3">
                        <i class="bi bi-inbox fs-2"></i>
                    </div>
                    <h5 class="fw-bold cat-heading mb-1">@Localizer["No products in this category yet"]</h5>
                    <p class="cat-subtitle small mx-auto mb-0" style="max-width: 380px;">
                        @Localizer["Assign products to this category from the product management screen."]
                    </p>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        window.CategoryDetailsConfig = {
            cartUrl: '@Url.Action("AddOrUpdate", "Cart")',
            favoriteUrl: '@Url.Action("Add", "Favorite")'
        };
    </script>
    <script src="~/js/Category/Details.js" asp-append-version="true"></script>
}