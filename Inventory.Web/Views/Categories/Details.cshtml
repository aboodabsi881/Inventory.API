@using Inventory.Web.ViewModels.Categories
@model CategoryDetailsVM

@{
    ViewData["Title"] = Localizer["Category Details"];
    var categoryImg = string.IsNullOrEmpty(Model.Img) ? "/images/placeholder.png" : Model.Img;
    var totalProducts = Model.ProductsVM?.Count ?? 0;
}

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<div class="container py-4">
    <!-- Category Banner Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5 bg-white">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex flex-column flex-md-row align-items-center gap-4">

                <div class="category-banner-preview position-relative rounded-4 p-2 bg-light border shadow-sm flex-shrink-0"
                     data-img="@categoryImg"
                     data-name="@Model.Name"
                     style="cursor: pointer;">
                    <img src="@categoryImg"
                         class="img-fluid rounded-3 object-fit-contain"
                         style="width: 130px; height: 130px;"
                         alt="@Model.Name"
                         onerror="this.onerror=null; this.src='/images/placeholder.png';"
                         title="@Localizer["Click to enlarge"]" />
                    <span class="position-absolute bottom-0 end-0 bg-white rounded-circle p-1 m-1 shadow-sm text-muted small d-flex">
                        <i class="bi bi-arrows-fullscreen"></i>
                    </span>
                </div>

                <div class="text-center text-md-start flex-grow-1">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 mb-2 small fw-semibold">
                        <i class="bi bi-tag-fill me-1"></i> @Localizer["Category Overview"]
                    </span>
                    <h2 class="fw-bolder text-dark mb-2">@Model.Name</h2>
                    <div class="d-inline-flex align-items-center bg-light rounded-pill px-3 py-1 text-muted small">
                        <i class="bi bi-box-seam text-primary me-2"></i>
                        <span>@Localizer["Total Products"]: <strong class="text-dark">@totalProducts</strong></span>
                    </div>
                </div>

                <div class="d-flex gap-2 w-100 w-md-auto justify-content-center">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning rounded-pill px-4 shadow-sm fw-semibold">
                        <i class="bi bi-pencil me-1"></i> @Localizer["Edit"]
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-arrow-left me-1"></i> @Localizer["Back"]
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Products Sub-Section Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h4 class="fw-bold text-dark mb-1 d-flex align-items-center">
                <i class="bi bi-grid-3x3-gap-fill text-primary me-2 fs-5"></i>
                @Localizer["Products in this Category"]
            </h4>
            <p class="text-muted small mb-0">@Localizer["Browse and manage products assigned under this group."]</p>
        </div>
    </div>

    <!-- Products Grid -->
    <div id="products-wrapper">
        @if (Model.ProductsVM != null && Model.ProductsVM.Any())
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4" id="products-container">
                @foreach (var product in Model.ProductsVM)
                {
                    var prodImg = string.IsNullOrEmpty(product.Img) ? "/images/placeholder.png" : product.Img;
                    <div class="col" id="product-card-@product.Id">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative product-card">

                            <!-- Favorite Action Button -->
                            <button type="button"
                                    class="btn btn-white bg-white rounded-circle position-absolute top-0 end-0 m-3 shadow-sm border-0 d-flex align-items-center justify-content-center fav-floating-btn"
                                    id="fav-btn-@product.Id"
                                    onclick="toggleFavorite(@product.Id)"
                                    title="@Localizer["Toggle favorite"]"
                                    style="width: 36px; height: 36px; z-index: 5;">
                                <i class="bi @(product.IsFavorite ? "bi-heart-fill text-danger" : "bi-heart text-secondary") fs-6" id="fav-icon-@product.Id"></i>
                            </button>

                            <!-- Product Image -->
                            <div class="bg-light p-3 d-flex align-items-center justify-content-center position-relative product-img-wrap" style="height: 180px;">
                                <a href="javascript:void(0)"
                                   class="product-image-preview w-100 h-100 d-flex align-items-center justify-content-center text-decoration-none"
                                   data-img="@prodImg"
                                   data-name="@product.Name">
                                    <img src="@prodImg"
                                         class="img-fluid object-fit-contain h-100 w-100 product-img"
                                         alt="@product.Name"
                                         onerror="this.onerror=null; this.src='/images/placeholder.png';"
                                         title="@Localizer["Click to enlarge"]" />
                                </a>
                            </div>

                            <!-- Card Body -->
                            <div class="card-body d-flex flex-column p-3">
                                <h6 class="card-title fw-bold text-dark text-truncate mb-2" title="@product.Name">
                                    @product.Name
                                </h6>

                                <div class="d-flex align-items-baseline gap-1 mb-3">
                                    <span class="fs-5 fw-bolder text-primary">$@product.Price.ToString("F2")</span>
                                </div>

                                <!-- Dynamic Cart Control Stepper -->
                                <div class="my-2" id="cart-control-container-@product.Id">
                                    @if (product.QuantityInCart > 0)
                                    {
                                        <div class="d-flex align-items-center justify-content-between bg-primary text-white rounded-pill px-2 py-1 shadow-sm" style="min-height: 38px;">
                                            <button type="button"
                                                    class="btn btn-sm text-white rounded-circle d-flex align-items-center justify-content-center p-0 border-0 bg-white bg-opacity-25 stepper-btn"
                                                    style="width: 28px; height: 28px;"
                                                    onclick="updateCartQuantity(@product.Id, -1)">
                                                <i class="bi bi-dash-lg"></i>
                                            </button>

                                            <span class="fw-bold px-1 fs-6 user-select-none text-truncate" id="card-qty-${product.Id}">
                                                @product.QuantityInCart <small class="fw-normal text-white-50 ms-1 small">@Localizer["in cart"]</small>
                                            </span>

                                            <button type="button"
                                                    class="btn btn-sm text-white rounded-circle d-flex align-items-center justify-content-center p-0 border-0 bg-white bg-opacity-25 stepper-btn"
                                                    style="width: 28px; height: 28px;"
                                                    onclick="updateCartQuantity(@product.Id, 1)">
                                                <i class="bi bi-plus-lg"></i>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-outline-primary w-100 rounded-pill py-2 shadow-sm d-flex align-items-center justify-content-center gap-2 fw-semibold"
                                                onclick="updateCartQuantity(@product.Id, 1)">
                                            <i class="bi bi-bag-plus fs-6"></i>
                                            <span>@Localizer["Add to Cart"]</span>
                                        </button>
                                    }
                                </div>

                                <div class="mt-auto pt-3 border-top">
                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="btn btn-light rounded-pill btn-sm w-100 fw-semibold text-muted">
                                        <i class="bi bi-eye me-1"></i> @Localizer["View Details"]
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-3">
                <div class="py-3">
                    <div class="bg-secondary-subtle text-secondary rounded-circle d-inline-flex p-3 mb-3">
                        <i class="bi bi-inbox fs-2"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">@Localizer["No products in this category yet"]</h5>
                    <p class="text-muted small mx-auto mb-0" style="max-width: 380px;">
                        @Localizer["Assign products to this category from the product management screen."]
                    </p>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        window.CategoryDetailsConfig = {
            cartUrl: '@Url.Action("AddOrUpdate", "Cart")',
            favoriteUrl: '@Url.Action("Add", "Favorite")',
            texts: {
                inCart: @Json.Serialize(Localizer["in cart"].Value),
                addToCart: @Json.Serialize(Localizer["Add to Cart"].Value),
                cartUpdated: @Json.Serialize(Localizer["Cart updated"].Value),
                itemRemoved: @Json.Serialize(Localizer["Item removed from cart"].Value),
                cartError: @Json.Serialize(Localizer["Failed to update cart."].Value),
                favError: @Json.Serialize(Localizer["Failed to update favorite status."].Value)
            }
        };
    </script>
    <script src="~/js/Category/Details.js" asp-append-version="true"></script>
}