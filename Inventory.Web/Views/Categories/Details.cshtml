@using Inventory.ViewModel.Categories
@model CategoryDetailsVM

@{
    ViewData["Title"] = "Category Details";
}

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<div class="container py-3">
    <!-- Category Header Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body d-flex align-items-center">
            <img src="@(string.IsNullOrEmpty(Model.Img) ? "/images/placeholder.png" : Model.Img)"
                 class="rounded me-4 object-fit-cover shadow-sm"
                 style="width: 120px; height: 120px;"
                 alt="@Model.Name" />
            <div>
                <h2 class="fw-bold mb-1 text-dark">@Model.Name</h2>
                <span class="badge bg-primary rounded-pill fs-6 fw-normal">
                    <i class="bi bi-box-seam me-1"></i>Total Products: @(Model.ProductsVM?.Count ?? 0)
                </span>
            </div>
            <div class="ms-auto d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning shadow-sm">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>
            </div>
        </div>
    </div>

    <h4 class="fw-bold mb-3 text-secondary"><i class="bi bi-tags me-2"></i>Products in this Category</h4>

    @if (Model.ProductsVM == null || !Model.ProductsVM.Any())
    {
        <div class="alert alert-secondary text-center p-4 shadow-sm border-0">
            <i class="bi bi-inbox display-6 d-block mb-2 text-muted"></i>
            No products in this category yet.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var product in Model.ProductsVM)
            {
                <div class="col" id="product-card-@product.Id">
                    <div class="card h-100 border-0 shadow-sm position-relative overflow-hidden">

                        <!-- 💡 Favorite Toggle Button -->
                        <button type="button"
                                class="btn btn-light btn-sm rounded-circle position-absolute top-0 end-0 m-2 shadow-sm favorite-btn"
                                id="fav-btn-@product.Id"
                                onclick="toggleFavorite(@product.Id)"
                                style="z-index: 10; width: 36px; height: 36px;">
                            <i class="bi @(product.IsFavorite ? "bi-heart-fill text-danger" : "bi-heart text-secondary") fs-5" id="fav-icon-@product.Id"></i>
                        </button>

                        <img src="@(string.IsNullOrEmpty(product.Img) ? "/images/placeholder.png" : product.Img)"
                             class="card-img-top object-fit-cover"
                             style="height: 160px;"
                             alt="@product.Name" />

                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="fw-bold text-dark text-truncate mb-0">@product.Name</h6>
                                <span class="badge bg-success rounded-pill">$@product.Price.ToString("F2")</span>
                            </div>

                            <div class="mt-auto pt-3 border-top">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-info btn-sm w-100">
                                    <i class="bi bi-eye me-1"></i> View Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 2000,
            timerProgressBar: true
        });

        function toggleFavorite(productId) {
            const token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '/Favorite/Add',
                type: 'POST',
                data: {
                    productId: productId,
                    __RequestVerificationToken: token
                },
                success: function (response) {
                    const icon = $(`#fav-icon-${productId}`);

                    if (response.isFavorite) {
                        icon.removeClass('bi-heart text-secondary').addClass('bi-heart-fill text-danger');
                    } else {
                        icon.removeClass('bi-heart-fill text-danger').addClass('bi-heart text-secondary');
                    }

                    Toast.fire({
                        icon: response.icon || 'success',
                        title: response.message
                    });
                },
                error: function () {
                    Toast.fire({
                        icon: 'error',
                        title: 'Failed to update favorite status.'
                    });
                }
            });
        }
    </script>
}