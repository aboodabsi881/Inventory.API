@model Inventory.ViewModel.Categories.CreateUpdateCategoryVM

@{
    ViewData["Title"] = "Edit Category";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow border-0">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Edit Category</h4>
            </div>
            <div class="card-body">
                <form id="editCategoryForm" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <!-- 💡 CRITICAL: Preserve existing ID and Image Path -->
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Img" />
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Img))
                    {
                        <div class="mb-3 text-center">
                            <label class="form-label d-block">Current Image</label>
                            <img src="@Model.Img" alt="@Model.Name" class="img-thumbnail" style="max-height: 120px;" />
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="ImgFile" class="form-label">Change Image (Optional)</label>
                        <!-- 💡 Optional file input -->
                        <input asp-for="ImgFile" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="ImgFile" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-check-lg"></i> Update Category
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $('#editCategoryForm').on('submit', function (e) {
            e.preventDefault();
            if (!$(this).valid()) return;

            var formData = new FormData(this);

            $.ajax({
                url: '/Categories/Edit/' + $('#Id').val(),
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    if (res.redirectUrl) {
                        window.location.href = res.redirectUrl;
                    }
                },
                error: function (xhr) {
                    const err = xhr.responseJSON;
                    alert(err?.message || "An error occurred while updating.");
                }
            });
        });
    </script>
}