@using Inventory.Web.ViewModels.Categories
@model CreateUpdateCategoryVM

@{
    ViewData["Title"] = "Edit Category";
}

<div class="row justify-content-center my-4">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-warning text-dark p-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>@Localizer["Edit Category"]</h4>
            </div>
            <div class="card-body p-4">
                <form id="editCategoryForm" asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Img" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">@Localizer["Name"]</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 text-center p-3 bg-light rounded-3 border">
                        <label class="form-label d-block small text-muted mb-2">@Localizer["Category Image Preview"]</label>
                        <img id="imgPreview"
                             src="@(string.IsNullOrEmpty(Model.Img) ? "/images/placeholder.png" : Model.Img)"
                             alt="@Model.Name"
                             class="img-thumbnail object-fit-cover shadow-sm"
                             style="max-height: 140px;"
                             onerror="this.onerror=null; this.src='/images/placeholder.png';" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="ImgFile" class="form-label fw-semibold">@Localizer["Change Image (Optional)"]</label>
                        <input asp-for="ImgFile" id="imgInput" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="ImgFile" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                            <i class="bi bi-arrow-left me-1"></i> @Localizer["Back to List"]
                        </a>
                        <button type="submit" class="btn btn-warning rounded-pill px-4 fw-semibold">
                            <i class="bi bi-save me-1"></i> @Localizer["Update Category"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Category/Edit.js"></script>
}