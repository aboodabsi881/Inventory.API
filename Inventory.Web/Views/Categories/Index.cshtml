@using Inventory.Web.ViewModels.Categories
@model IEnumerable<CategoryVM>

@{
    ViewData["Title"] = "Categories";
}


<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<div class="container py-4">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bolder header-title mb-1 d-flex align-items-center">
                <span class="p-2 rounded-circle bg-primary-subtle text-primary me-2 d-inline-flex">
                    <i class="bi bi-tags-fill fs-5"></i>
                </span>
                @Localizer["Categories"]
            </h2>
            <p class="header-subtitle mb-0 small">@Localizer["Organize, group, and manage your inventory catalog."]</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm d-inline-flex align-items-center gap-2">
            <i class="bi bi-plus-lg"></i>
            <span>@Localizer["Add New Category"]</span>
        </a>
    </div>

    <!-- Category Grid -->
    <div id="categories-wrapper">
        @if (Model != null && Model.Any())
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4" id="categories-container">
                @foreach (var category in Model)
                {
                    var imgSrc = string.IsNullOrEmpty(category.Img) ? "/images/placeholder.png" : category.Img;
                    var productCount = category.Products?.Count ?? 0;

                    <div class="col" id="category-card-@category.Id">
                        <div class="card h-100 shadow-sm rounded-4 overflow-hidden position-relative category-card">

                            <!-- Image Container -->
                            <div class="p-3 d-flex align-items-center justify-content-center position-relative category-img-wrap" style="height: 190px;">
                                <img src="@imgSrc"
                                     class="img-fluid object-fit-contain h-100 w-100 category-img"
                                     alt="@category.Name"
                                     onerror="this.onerror=null; this.src='/images/placeholder.png';"
                                     title="@category.Name" />
                            </div>

                            <!-- Card Body -->
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h6 class="card-title fw-bold category-title text-truncate mb-0" title="@category.Name">
                                        @category.Name
                                    </h6>
                                </div>

                                <div class="mb-3">
                                    <span class="badge bg-primary text-white rounded-pill px-2.5 py-1 small">
                                        <i class="bi bi-box-seam me-1"></i>@productCount @Localizer["Products"]
                                    </span>
                                </div>

                                <!-- Action Buttons with High-Contrast Text -->
                                <div class="mt-auto d-flex justify-content-between gap-1 pt-3 border-top">
                                    <a asp-action="Details" asp-route-id="@category.Id" class="btn btn-action-view btn-sm rounded-pill flex-fill fw-semibold">
                                        <i class="bi bi-info-circle"></i> @Localizer["Details"]
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-action-edit btn-sm rounded-pill flex-fill fw-semibold">
                                        <i class="bi bi-pencil"></i> @Localizer["Edit"]
                                    </a>
                                    <button type="button"
                                            class="btn btn-action-delete btn-sm rounded-pill px-3 btn-delete-category"
                                            data-id="@category.Id"
                                            data-name="@category.Name"
                                            title="@Localizer["Delete"]">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card border shadow-sm rounded-4 p-5 text-center my-4 category-card">
                <div class="py-4">
                    <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex p-4 mb-3">
                        <i class="bi bi-tags display-4"></i>
                    </div>
                    <h4 class="fw-bold category-title mb-2">@Localizer["No categories found"]</h4>
                    <p class="category-desc mx-auto mb-4" style="max-width: 420px;">
                        @Localizer["Get started by adding your first product category to organize your inventory."]
                    </p>
                    <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm">
                        <i class="bi bi-plus-lg me-1"></i> @Localizer["Add New Category"]
                    </a>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        window.CategoryConfig = {
            deleteUrl: '@Url.Action("DeleteConfirmed", "Categories")',
            texts: {
                areYouSure: @Json.Serialize(Localizer["Are you sure?"].Value),
                deleteConfirm: @Json.Serialize(Localizer["Do you really want to delete the category"].Value),
                yesDelete: @Json.Serialize(Localizer["Yes, delete it!"].Value),
                deleted: @Json.Serialize(Localizer["Deleted!"].Value),
                oops: @Json.Serialize(Localizer["Oops..."].Value),
                errorDefault: @Json.Serialize(Localizer["Failed to delete category."].Value)
                    }
        };
    </script>
    <script src="~/js/Category/Index.js"></script>
}