@using Inventory.Web.ViewModels.Categories
@model IEnumerable<CategoryVM>

@{
    ViewData["Title"] = "Categories";
}

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-dark"><i class="bi bi-tags me-2 text-primary"></i>@Localizer["Categories"]</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> @Localizer["Add New Category"]   
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center" role="alert">
        @Localizer["No categories found. Click"] <strong>@Localizer["Add New Category"]</strong> @Localizer["to create one!"]
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var category in Model)
        {
            <div class="col" id="category-card-@category.Id">
                <div class="card h-100 shadow-sm border-0">
                    <a href="javascript:void(0)"
                       onclick="showFullImage('@(string.IsNullOrEmpty(category.Img) ? "/images/placeholder.png" : category.Img)', '@category.Name')">
                        <img src="@(string.IsNullOrEmpty(category.Img) ? "/images/placeholder.png" : category.Img)"
                             class="card-img-top object-fit-contain p-2 bg-light border-bottom"
                             alt="@category.Name"
                             style="height: 200px; cursor: pointer;"
                             title="Click to view full image">
                    </a>

                    <div class="card-body">
                        <h5 class="card-title fw-bold">@category.Name</h5>
                        <p class="card-text text-muted">
                            <i class="bi bi-box-seam me-1"></i> @Localizer["Products"]: @(category.Products?.Count ?? 0)
                        </p>
                    </div>

                    <div class="card-footer bg-transparent border-0 pb-3 d-flex justify-content-between">
                        <a asp-action="Details" asp-route-id="@category.Id" class="btn btn-outline-info btn-sm">
                            <i class="bi bi-eye"></i> @Localizer["Details"]
                        </a>
                        <div>
                            <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-outline-warning btn-sm me-1">
                                <i class="bi bi-pencil"></i> @Localizer["Edit"]
                            </a>
                            <button type="button" class="btn btn-outline-danger btn-sm" onclick="deleteCategory(@category.Id, '@category.Name')">
                                <i class="bi bi-trash"></i> @Localizer["Delete"]
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
       const localizedTexts = {
            areYouSure: "@Html.Raw(Localizer["Are you sure?"].Value)",
            deleteConfirm: "@Html.Raw(Localizer["Do you really want to delete the category"].Value)",
            yesDelete: "@Html.Raw(Localizer["Yes, delete it!"].Value)",
            deleted: "@Html.Raw(Localizer["Deleted!"].Value)",
            oops: "@Html.Raw(Localizer["Oops..."].Value)",
            errorDefault: "@Html.Raw(Localizer["Failed to delete category."].Value)"
        };

        function showFullImage(imgUrl, categoryName) {
            Swal.fire({
                title: categoryName || 'Category Image',
                imageUrl: imgUrl,
                imageAlt: categoryName,
                imageWidth: 500,
                imageHeight: 'auto',
                showConfirmButton: false,
                showCloseButton: true,
                background: '#fff',
                customClass: {
                    image: 'img-fluid rounded shadow-sm'
                }
            });
        }

        function deleteCategory(id, name) {
            Swal.fire({
                title: localizedTexts.areYouSure,
                text: `${localizedTexts.deleteConfirm} "${name}"?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: localizedTexts.yesDelete
            }).then((result) => {
                if (result.isConfirmed) {
                    const token = $('input[name="__RequestVerificationToken"]').val();

                    $.ajax({
                        url: `@Url.Action("DeleteConfirmed")/${id}`,
                        type: 'POST',
                        data: {
                            __RequestVerificationToken: token
                        },
                        success: function(response) {
                            Swal.fire({
                                icon: response.icon || 'success',
                                title: localizedTexts.deleted,
                                text: response.message,
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => {
                                $(`#category-card-${id}`).fadeOut(300, function() {
                                    $(this).remove();
                                });
                            });
                        },
                        error: function(xhr) {
                            const err = xhr.responseJSON;
                            Swal.fire({
                                icon: 'error',
                                title: localizedTexts.oops,
                                text: err ? err.message : localizedTexts.errorDefault
                            });
                        }
                    });
                }
            });
        }
    </script>
}