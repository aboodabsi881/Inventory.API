@using Inventory.Web.ViewModels.Favorites
@model IEnumerable<FavoriteVM>

@{
    ViewData["Title"] = Localizer["My Favorites"];
}

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<div class="container py-4">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold header-title mb-1 d-flex align-items-center">
                <span class="p-2 rounded-circle bg-danger-subtle text-danger me-2 d-inline-flex">
                    <i class="bi bi-heart-fill fs-5"></i>
                </span>
                @Localizer["My Favorites"]
            </h2>
            <p class="header-subtitle mb-0 small">@Localizer["Items you have saved to your wishlist."]</p>
        </div>
        <a asp-controller="Products" asp-action="Index" class="btn btn-action-back rounded-pill px-4 shadow-sm fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> @Localizer["Back to Products"]
        </a>
    </div>

    <!-- Cards Grid -->
    <div id="favorites-wrapper">
        @if (Model != null && Model.Any())
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4" id="favorites-container">
                @foreach (var item in Model)
                {
                    var imgSrc = string.IsNullOrEmpty(item.ProductImg) ? "/images/placeholder.png" : item.ProductImg;
                    <div class="col" id="favorite-card-@item.Id">
                        <div class="card h-100 border shadow-sm rounded-4 overflow-hidden position-relative product-card">

                            <!-- Instant Toggle Favorite Button -->
                            <button type="button"
                                    class="btn rounded-circle position-absolute top-0 end-0 m-3 shadow-sm border-0 d-flex align-items-center justify-content-center fav-floating-btn"
                                    id="fav-btn-@item.Id"
                                    onclick="toggleFavoriteRemove(@item.Id)"
                                    title="@Localizer["Remove from favorites"]"
                                    style="width: 36px; height: 36px; z-index: 5;">
                                <i class="bi bi-heart-fill text-danger fs-6" id="fav-icon-@item.Id"></i>
                            </button>

                            <!-- Image Container -->
                            <div class="p-3 d-flex align-items-center justify-content-center img-surface-wrap" style="height: 190px;">
                                <img src="@imgSrc"
                                     class="img-fluid object-fit-contain h-100 w-100 product-img"
                                     alt="@item.ProductName"
                                     onerror="this.onerror=null; this.src='/images/placeholder.png';" />
                            </div>

                            <!-- Body -->
                            <div class="card-body d-flex flex-column p-3">
                                <h6 class="card-title fw-bold product-name-heading text-truncate mb-2" title="@item.ProductName">
                                    @(item.ProductName ?? Localizer["Unnamed Product"].Value)
                                </h6>

                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <span class="fs-5 fw-bold text-primary" dir="ltr">$@item.ProductPrice.ToString("F2")</span>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 small">
                                        @Localizer["In Stock"]
                                    </span>
                                </div>

                                <div class="mt-auto d-flex">
                                    <a asp-controller="Products"
                                       asp-action="Details"
                                       asp-route-id="@item.ProductId"
                                       asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                                       class="btn btn-action-view rounded-pill btn-sm flex-fill fw-semibold py-2">
                                        <i class="bi bi-eye me-1"></i> @Localizer["View Product"]
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card border shadow-sm rounded-4 p-5 text-center my-4" id="empty-favorites-card">
                <div class="py-4">
                    <div class="bg-danger-subtle text-danger rounded-circle d-inline-flex p-4 mb-3">
                        <i class="bi bi-heartbreak display-4"></i>
                    </div>
                    <h4 class="fw-bold header-title mb-2">@Localizer["Your favorite list is empty"]</h4>
                    <p class="header-subtitle mx-auto mb-4" style="max-width: 420px;">
                        @Localizer["Explore our catalog and save your preferred products here!"]
                    </p>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm">
                        <i class="bi bi-grid-fill me-1"></i> @Localizer["Browse Products"]
                    </a>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        window.FavoriteConfig = {
            deleteUrl: '@Url.Action("DeleteConfirmed", "Favorite")'
                };
    </script>
    <script src="~/js/Favorite/Index.js" asp-append-version="true"></script>
}