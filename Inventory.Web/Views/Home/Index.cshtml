@using Inventory.Web.ViewModels.Home
@model DashboardVM

@{
    ViewData["Title"] = Localizer["Dashboard"];
    var isRtl = System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
}

<div class="container-fluid px-lg-4 py-4">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bolder dashboard-heading mb-1 d-flex align-items-center">
                <span class="p-2 rounded-circle bg-primary-subtle text-primary me-2 d-inline-flex">
                    <i class="bi bi-speedometer2 fs-5"></i>
                </span>
                @Localizer["System Dashboard"]
            </h2>
            <p class="dashboard-subtitle mb-0 text-muted small">@Localizer["Real-time overview of system inventory, valuation, and metrics."]</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2 fw-semibold d-flex align-items-center gap-1">
                <i class="bi bi-activity"></i> @Localizer["Live Status"]
            </span>
            <a asp-controller="Products" asp-action="Create"  class="btn btn-primary rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-1">
                <i class="bi bi-plus-lg"></i>
                <span>@Localizer["New Product"]</span>
            </a>
        </div>
    </div>

    <!-- Top KPI Cards Grid -->
    <div class="row g-3 mb-4">
        <!-- Total Inventory Value -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100 dashboard-card position-relative overflow-hidden">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold d-block mb-1">@Localizer["Total Stock Value"]</span>
                        <h3 class="fw-bold text-success mb-0">$@Model.TotalInventoryValue.ToString("N2")</h3>
                        <small class="text-muted">@Model.TotalStockUnits @Localizer["total units"]</small>
                    </div>
                    <div class="bg-success-subtle text-success rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                        <i class="bi bi-currency-dollar fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Products -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100 dashboard-card">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold d-block mb-1">@Localizer["Total Products"]</span>
                        <h3 class="fw-bold text-primary mb-0">@Model.TotalProducts</h3>
                        <small class="text-muted">@Model.TotalCategories @Localizer["categories"]</small>
                    </div>
                    <div class="bg-primary-subtle text-primary rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                        <i class="bi bi-boxes fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Low & Out of Stock Alerts -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100 dashboard-card">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold d-block mb-1">@Localizer["Stock Warnings"]</span>
                        <div class="d-flex align-items-baseline gap-2">
                            <h3 class="fw-bold text-warning mb-0">@Model.LowStockCount</h3>
                            <span class="badge bg-danger-subtle text-danger rounded-pill small">@Model.OutOfStockCount @Localizer["empty"]</span>
                        </div>
                        <small class="text-muted">@Localizer["Needs restocking"]</small>
                    </div>
                    <div class="bg-warning-subtle text-warning-emphasis rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Active Users -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100 dashboard-card">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold d-block mb-1">@Localizer["System Accounts"]</span>
                        <h3 class="fw-bold text-info mb-0">@Model.TotalUsers</h3>
                        <small class="text-muted">@Localizer["Authorized staff"]</small>
                    </div>
                    <div class="bg-info-subtle text-info rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-4 mb-4">
        <!-- Stock Distribution Bar Chart -->
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 dashboard-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold dashboard-heading mb-0">
                            <i class="bi bi-bar-chart-line-fill text-primary me-2"></i>@Localizer["Top Stocked Products"]
                        </h5>
                        <p class="text-muted small mb-0">@Localizer["Current inventory level for leading products"]</p>
                    </div>
                </div>
                <div style="height: 280px; position: relative;">
                    <canvas id="stockBarChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Category Distribution Doughnut Chart -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 dashboard-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold dashboard-heading mb-0">
                            <i class="bi bi-pie-chart-fill text-info me-2"></i>@Localizer["Categories Breakdown"]
                        </h5>
                        <p class="text-muted small mb-0">@Localizer["Products per category"]</p>
                    </div>
                </div>
                <div style="height: 280px; position: relative;">
                    <canvas id="categoryPieChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Split: Quick Actions & Recent Products -->
    <div class="row g-4">
        <!-- Quick Actions Panel -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 dashboard-card h-100">
                <h5 class="fw-bold dashboard-heading mb-3">
                    <i class="bi bi-lightning-charge-fill me-2 text-warning"></i>@Localizer["Quick Actions"]
                </h5>
                <div class="d-grid gap-2">
                    <a asp-controller="Products" asp-action="Create" class="btn btn-outline-primary text-start rounded-3 p-3 d-flex align-items-center justify-content-between shadow-sm">
                        <span><i class="bi bi-plus-circle me-2"></i> @Localizer["Add New Product"]</span>
                        <i class="bi bi-chevron-right small text-muted"></i>
                    </a>
                    <a asp-controller="Categories" asp-action="Create" class="btn btn-outline-secondary text-start rounded-3 p-3 d-flex align-items-center justify-content-between shadow-sm">
                        <span><i class="bi bi-folder-plus me-2"></i> @Localizer["Add New Category"]</span>
                        <i class="bi bi-chevron-right small text-muted"></i>
                    </a>
                    @if (User.IsInRole("SuperAdmin") || User.IsInRole("Super Admin") || User.IsInRole("Admin"))
                    {
                        <a asp-controller="Accounts" asp-action="Register" class="btn btn-outline-info text-start rounded-3 p-3 d-flex align-items-center justify-content-between shadow-sm">
                            <span><i class="bi bi-person-plus me-2"></i> @Localizer["Register System User"]</span>
                            <i class="bi bi-chevron-right small text-muted"></i>
                        </a>
                        <a asp-controller="Roles" asp-action="Index" class="btn btn-outline-secondary text-start rounded-3 p-3 d-flex align-items-center justify-content-between shadow-sm">
                            <span class="text-body"><i class="bi bi-shield-lock me-2 text-warning"></i> @Localizer["Access Control"]</span>
                            <i class="bi bi-chevron-right small text-muted"></i>
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Recent Products Table -->
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden dashboard-card">
                <div class="card-header bg-transparent border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold dashboard-heading mb-0">
                        <i class="bi bi-clock-history me-2 text-primary"></i>@Localizer["Recently Added Products"]
                    </h5>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-sm btn-link text-decoration-none fw-semibold">
                        @Localizer["View Full Catalog"] <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover table-custom align-middle mb-0">
                        <thead class="bg-light text-secondary small fw-semibold">
                            <tr>
                                <th class="ps-4">@Localizer["Product"]</th>
                                <th>@Localizer["Category"]</th>
                                <th>@Localizer["Price"]</th>
                                <th>@Localizer["Stock Level"]</th>
                                <th class="text-end pe-4">@Localizer["Action"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentProducts != null && Model.RecentProducts.Any())
                            {
                                @foreach (var p in Model.RecentProducts)
                                {
                                    var isOut = p.StockQuantity <= 0;
                                    var isLow = p.StockQuantity > 0 && p.StockQuantity <= 5;
                                    <tr>
                                        <td class="ps-4 fw-semibold">
                                            <span class="table-item-title">@p.Name</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2.5 py-1">
                                                @(string.IsNullOrEmpty(p.CategoryName) ? Localizer["Uncategorized"].Value : p.CategoryName)
                                            </span>
                                        </td>
                                        <td class="fw-bold text-primary">$@p.Price.ToString("F2")</td>
                                        <td style="min-width: 140px;">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="progress flex-grow-1" style="height: 6px;">
                                                    <div class="progress-bar @(isOut ? "bg-danger" : isLow ? "bg-warning" : "bg-success")"
                                                         role="progressbar"
                                                         style="width: @(Math.Min(100, p.StockQuantity * 10))%"></div>
                                                </div>
                                                <span class="small fw-semibold @(isOut ? "text-danger" : isLow ? "text-warning" : "text-success")">
                                                    @p.StockQuantity
                                                </span>
                                            </div>
                                        </td>
                                        <td class="text-end pe-4">
                                            <a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5" title="@Localizer["Details"]">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-controller="Products" asp-action="Edit" asp-route-id="@p.Id"   class="btn btn-sm btn-outline-warning rounded-pill px-2.5 ms-1" title="@Localizer["Edit"]">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">@Localizer["No products found in the database."]</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        window.DashboardConfig = {
            topProducts: {
                labels: @Json.Serialize(Model.TopProductLabels),
                quantities: @Json.Serialize(Model.TopProductQuantities),
                datasetLabel: @Json.Serialize(Localizer["Quantity in Stock"].Value)
                    },
            categories: {
                labels: @Json.Serialize(Model.CategoryLabels),
                counts: @Json.Serialize(Model.CategoryProductCounts),
                emptyLabel: @Json.Serialize(Localizer["No Data"].Value)
                    }
        };
    </script>
    <script src="~/js/Home/Dashboard.js" asp-append-version="true"></script>
}