@using Inventory.Web.ViewModels.Home
@model DashboardVM

@{
    ViewData["Title"] = "Dashboard";
}
<div class="container py-3">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold dashboard-heading mb-1 d-flex align-items-center">
                <i class="bi bi-speedometer2 me-2 text-primary"></i>@Localizer["System Dashboard"]
            </h2>
            <p class="dashboard-subtitle mb-0 small">@Localizer["Real-time overview of system inventory and accounts."]</p>
        </div>
        <div>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2 fw-semibold">
                <i class="bi bi-clock me-1"></i> @Localizer["Live Status"]
            </span>
        </div>
    </div>

    <!-- KPI Metric Cards Grid -->
    <div class="row g-3 mb-4">
        <!-- Total Products -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 dashboard-card h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="metric-label small fw-medium d-block mb-1">@Localizer["Total Products"]</span>
                        <h3 class="fw-bold metric-value mb-0">@Model.TotalProducts</h3>
                    </div>
                    <div class="bg-primary-subtle text-primary rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-boxes fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Low Stock Alert -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 dashboard-card h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="metric-label small fw-medium d-block mb-1">@Localizer["Low Stock Items"]</span>
                        <h3 class="fw-bold text-danger mb-0">@Model.LowStockCount</h3>
                    </div>
                    <div class="bg-danger-subtle text-danger rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Categories -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 dashboard-card h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="metric-label small fw-medium d-block mb-1">@Localizer["Categories"]</span>
                        <h3 class="fw-bold metric-value mb-0">@Model.TotalCategories</h3>
                    </div>
                    <div class="bg-info-subtle text-info rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-grid-1x2-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- System Users -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 dashboard-card h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="metric-label small fw-medium d-block mb-1">@Localizer["System Users"]</span>
                        <h3 class="fw-bold metric-value mb-0">@Model.TotalUsers</h3>
                    </div>
                    <div class="bg-success-subtle text-success rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Shortcuts & Recent Activity Split -->
    <div class="row g-4">
        <!-- Quick Actions Panel -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 dashboard-card h-100">
                <h5 class="fw-bold dashboard-heading mb-3">
                    <i class="bi bi-lightning-charge me-2 text-warning"></i>@Localizer["Quick Actions"]
                </h5>
                <div class="d-grid gap-2">
                    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("Super Admin"))
                    {
                        <a asp-controller="Products" asp-action="Create" class="btn btn-outline-primary text-start rounded-3 p-3">
                            <i class="bi bi-plus-circle me-2"></i> @Localizer["Add New Product"]
                        </a>
                        <a asp-controller="Categories" asp-action="Create" class="btn btn-outline-secondary text-start rounded-3 p-3">
                            <i class="bi bi-folder-plus me-2"></i> @Localizer["Add Category"]
                        </a>
                    }
                    @if (User.IsInRole("SuperAdmin") || User.IsInRole("Super Admin"))
                    {
                        <a asp-controller="Accounts" asp-action="Register" class="btn btn-outline-info text-start rounded-3 p-3">
                            <i class="bi bi-person-plus me-2"></i> @Localizer["Register System User"]
                        </a>
                        <a asp-controller="Roles" asp-action="Index" class="btn btn-outline-secondary btn-action-outline-dark text-start rounded-3 p-3">
                            <i class="bi bi-shield-lock me-2"></i> @Localizer["Access Control"]
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Recent Products Table -->
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden dashboard-card">
                <div class="card-header bg-transparent border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold dashboard-heading mb-0">
                        <i class="bi bi-clock-history me-2 text-primary"></i>@Localizer["Recent Products"]
                    </h5>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">@Localizer["View All"]</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover table-custom align-middle mb-0">
                        <thead class="bg-light text-secondary small fw-semibold">
                            <tr>
                                <th class="ps-4">@Localizer["Product Name"]</th>
                                <th>@Localizer["Category"]</th>
                                <th>@Localizer["Price"]</th>
                                <th>@Localizer["Stock Status"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentProducts != null && Model.RecentProducts.Any())
                            {
                                @foreach (var p in Model.RecentProducts)
                                {
                                    <tr>
                                        <td class="ps-4 fw-semibold table-item-title">@p.Name</td>
                                        <td class=" fw-semibold table-item-title">
                                                @(string.IsNullOrEmpty(p.CategoryName) ? Localizer["Uncategorized"].Value : p.CategoryName)
                                        </td>
                                        <td class="fw-bold text-primary">$@p.Price.ToString("F2")</td>
                                        <td>
                                            @if (p.StockQuantity <= 5)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1">
                                                    @Localizer["Low"] (@p.StockQuantity)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">
                                                    @Localizer["In Stock"] (@p.StockQuantity)
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">@Localizer["No recent items available."]</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>