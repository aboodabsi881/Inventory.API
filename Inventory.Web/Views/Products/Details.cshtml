@using Inventory.Web.ViewModels.Products
@model ProductDetailsVM

@{
    ViewData["Title"] = Localizer["Product Details"];

    var userRoles = User.Claims
                        .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
                        .Select(c => c.Value.Trim().ToLower())
                        .ToList();

    bool isSuperAdmin = userRoles.Any(r => r == "superadmin" || r == "super admin");
    bool isAdmin = userRoles.Any(r => r == "admin") || isSuperAdmin;
    bool isAuthenticated = User.Identity?.IsAuthenticated ?? false;

    var returnUrl = Context.Request.Query["returnUrl"].ToString();
    var backUrl = !string.IsNullOrEmpty(returnUrl) ? returnUrl : Url.Action("Index", "Products");
}

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<div class="row justify-content-center my-4">
    <div class="col-md-9 col-lg-8">
        <div class="card shadow-sm border rounded-4 overflow-hidden product-card">
            <div class="row g-0">

                <!-- Product Image Area -->
                <div class="col-md-5 p-4 border-end position-relative d-flex align-items-center justify-content-center img-surface-wrap">
                    <button type="button"
                            class="btn rounded-circle position-absolute top-0 start-0 m-3 shadow-sm fav-floating-btn"
                            onclick="toggleFavorite(@Model.Id)"
                            title="@Localizer["Toggle favorite"]"
                            style="width: 38px; height: 38px; z-index: 10;">
                        <i class="bi @(Model.IsFavorite ? "bi-heart-fill text-danger" : "bi-heart text-secondary") fs-5" id="fav-icon-@Model.Id"></i>
                    </button>

                    <img src="@(string.IsNullOrEmpty(Model.Img) ? "/images/placeholder.png" : Model.Img)"
                         alt="@Model.Name"
                         class="img-fluid rounded-3 object-fit-contain"
                         style="max-height: 280px;"
                         onerror="this.onerror=null; this.src='/images/placeholder.png';" />
                </div>

                <!-- Product Content Area -->
                <div class="col-md-7">
                    <div class="card-body p-4 d-flex flex-column h-100">
                        <div class="mb-3">
                            <span class="badge category-badge-pill rounded-pill px-3 py-2 mb-2">
                                <i class="bi bi-tag me-1"></i>@(string.IsNullOrEmpty(Model.CategoryName) ? Localizer["Uncategorized"].Value : Model.CategoryName)
                            </span>
                            <h3 class="card-title fw-bold product-name-heading mb-1">@Model.Name</h3>
                            <h4 class="text-success fw-bold mb-0">$@Model.Price.ToString("F2")</h4>
                        </div>

                        <!-- Specification List -->
                        <ul class="list-group list-group-flush mb-3">
                            <li class="list-group-item bg-transparent px-0 d-flex justify-content-between align-items-center">
                                <span class="text-muted"><i class="bi bi-hash me-1"></i>@Localizer["Product ID"]</span>
                                <span class="fw-semibold text-main">#@Model.Id</span>
                            </li>
                            <li class="list-group-item bg-transparent px-0 d-flex justify-content-between align-items-center">
                                <span class="text-muted"><i class="bi bi-grid me-1"></i>@Localizer["Category"]</span>
                                <span class="fw-semibold text-main">
                                    @(string.IsNullOrWhiteSpace(Model.CategoryName) ? Localizer["Uncategorized"].Value : Model.CategoryName)
                                </span>
                            </li>
                            <li class="list-group-item bg-transparent px-0 d-flex justify-content-between align-items-center">
                                <span class="text-muted"><i class="bi bi-lightning-charge me-1"></i>@Localizer["Power Type"]</span>
                                <span class="fw-semibold text-main">@(Model.PowerType.HasValue ? Model.PowerType.Value.ToString() : Localizer["N/A"].Value)</span>
                            </li>
                        </ul>

                        <!-- Cart Stepper Control -->
                        <div class="my-3" id="cart-control-container-@Model.Id">
                            @if (Model.QuantityInCart > 0)
                            {
                                <div class="d-flex align-items-center justify-content-between bg-primary text-white rounded-pill px-3 py-2 shadow-sm" style="min-height: 45px;">
                                    <button type="button"
                                            class="btn btn-sm text-white rounded-circle d-flex align-items-center justify-content-center p-0 border-0 bg-white bg-opacity-25 stepper-btn"
                                            style="width: 32px; height: 32px;"
                                            onclick="updateCartQuantity(@Model.Id, -1)">
                                        <i class="bi bi-dash-lg fs-6"></i>
                                    </button>

                                    <span class="fw-bold px-3 fs-6 user-select-none" id="card-qty-@Model.Id">
                                        @Model.QuantityInCart <small class="fw-normal text-white-50 ms-1 small">@Localizer["in cart"]</small>
                                    </span>

                                    <button type="button"
                                            class="btn btn-sm text-white rounded-circle d-flex align-items-center justify-content-center p-0 border-0 bg-white bg-opacity-25 stepper-btn"
                                            style="width: 32px; height: 32px;"
                                            onclick="updateCartQuantity(@Model.Id, 1)">
                                        <i class="bi bi-plus-lg fs-6"></i>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-primary bg-primary-subtle text-primary border-0 w-100 rounded-pill py-2.5 shadow-sm d-flex align-items-center justify-content-center gap-2 fw-semibold"
                                        onclick="updateCartQuantity(@Model.Id, 1)">
                                    <i class="bi bi-bag-plus-fill fs-5"></i>
                                    <span>@Localizer["Add to Cart"]</span>
                                </button>
                            }
                        </div>

                        <!-- Action Buttons -->
                        <div class="mt-auto d-flex flex-wrap gap-2 border-top pt-3">
                            @if (isAdmin)
                            {
                                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning rounded-pill px-4 flex-fill fw-semibold">
                                    <i class="bi bi-pencil me-1"></i> @Localizer["Edit"]
                                </a>
                            }
                            <a href="@backUrl" class="btn btn-action-back rounded-pill px-4 flex-fill">
                                <i class="bi bi-arrow-left me-1"></i> @Localizer["Back"]
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
                window.AppConfig = {
                isAuthenticated: @(isAuthenticated.ToString().ToLower()),
                loginUrl: '@Url.Action("Login", "Accounts")',
                endpoints: {
                    cartAddOrUpdate: '@Url.Action("AddOrUpdate", "Cart")',
            favoriteAdd: '@Url.Action("Add", "Favorite")'
        },
        texts: {
            inCart: @Json.Serialize(Localizer["in cart"].Value),
            addToCart: @Json.Serialize(Localizer["Add to Cart"].Value),
            signInRequired: @Json.Serialize(Localizer["Sign In Required"].Value),
            signInPrompt: @Json.Serialize(Localizer["Please log in to manage your cart and favorites."].Value),
            signInBtn: @Json.Serialize(Localizer["Sign In"].Value),
            cartRemoved: @Json.Serialize(Localizer["Item removed from cart"].Value),
            cartUpdated: @Json.Serialize(Localizer["Cart updated"].Value),
            cartError: @Json.Serialize(Localizer["Failed to update cart."].Value),
            favError: @Json.Serialize(Localizer["Failed to update favorite status."].Value)
                }
            };
    </script>
    <script src="~/js/Product/Details.js" asp-append-version="true"></script>
}