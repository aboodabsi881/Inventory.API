@using Inventory.Web.ViewModels.Products
@model ProductDetailsVM

@{
    ViewData["Title"] = "Product Details";

    // 💡 فحص مرن للأدوار لمنع مشاكل حالة الأحرف
    var userRoles = User.Claims
                        .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
                        .Select(c => c.Value.Trim().ToLower())
                        .ToList();

    bool isSuperAdmin = userRoles.Any(r => r == "superadmin" || r == "super admin");
    bool isAdmin = userRoles.Any(r => r == "admin") || isSuperAdmin;
    bool isAuthenticated = User.Identity?.IsAuthenticated ?? false;
}

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<div class="row justify-content-center my-4">
    <div class="col-md-9 col-lg-8">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="row g-0">

                <!-- Product Image Section -->
                <div class="col-md-5 bg-light d-flex align-items-center justify-content-center p-4 border-end position-relative">

                    <!-- Favorite Toggle Button -->
                    <button type="button"
                            class="btn btn-light btn-sm rounded-circle position-absolute top-0 start-0 m-3 shadow-sm"
                            onclick="toggleFavorite(@Model.Id)"
                            style="width: 38px; height: 38px; z-index: 10;">
                        <i class="bi @(Model.IsFavorite ? "bi-heart-fill text-danger" : "bi-heart text-secondary") fs-5" id="fav-icon-@Model.Id"></i>
                    </button>

                    <img src="@(string.IsNullOrEmpty(Model.Img) ? "/images/placeholder.png" : Model.Img)"
                         alt="@Model.Name"
                         class="img-fluid rounded-3 object-fit-contain"
                         style="max-height: 280px;"
                         onerror="this.onerror=null; this.src='/images/placeholder.png';" />
                </div>

                <!-- Product Info Section -->
                <div class="col-md-7">
                    <div class="card-body p-4 d-flex flex-column h-100">
                        <div class="mb-3">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2 mb-2">
                                <i class="bi bi-tag me-1"></i>@(string.IsNullOrEmpty(Model.CategoryName) ? "Uncategorized" : Model.CategoryName)
                            </span>
                            <h3 class="card-title fw-bold text-dark mb-1">@Model.Name</h3>
                            <h4 class="text-success fw-bold mb-0">$@Model.Price.ToString("F2")</h4>
                        </div>

                        <ul class="list-group list-group-flush mb-3">
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                <span class="text-muted"><i class="bi bi-hash me-1"></i>Product ID</span>
                                <span class="fw-semibold">#@Model.Id</span>
                            </li>
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                <span class="text-muted"><i class="bi bi-grid me-1"></i>Category</span>
                                <span class="fw-semibold">
                                    @(string.IsNullOrWhiteSpace(Model.CategoryName) ? "Uncategorized" : Model.CategoryName)
                                </span>
                            </li>
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                <span class="text-muted"><i class="bi bi-lightning-charge me-1"></i>Power Type</span>
                                <span class="fw-semibold">@(Model.PowerType.HasValue ? Model.PowerType.Value.ToString() : "N/A")</span>
                            </li>
                        </ul>

                        <!-- 🛒 Pure Bootstrap Primary Cart Stepper (Identical to Index) -->
                        <div class="my-3" id="cart-control-container-@Model.Id">
                            @if (Model.QuantityInCart > 0)
                            {
                                <div class="d-flex align-items-center justify-content-between bg-primary text-white rounded-pill px-3 py-2 shadow-sm" style="min-height: 45px;">
                                    <button type="button"
                                            class="btn btn-sm text-white rounded-circle d-flex align-items-center justify-content-center p-0 border-0 bg-white bg-opacity-25"
                                            style="width: 32px; height: 32px;"
                                            onclick="updateCartQuantity(@Model.Id, -1)">
                                        <i class="bi bi-dash-lg fs-6"></i>
                                    </button>

                                    <span class="fw-bold px-3 fs-6 user-select-none" id="card-qty-@Model.Id">
                                        @Model.QuantityInCart <small class="fw-normal text-white-50 ms-1 small">in cart</small>
                                    </span>

                                    <button type="button"
                                            class="btn btn-sm text-white rounded-circle d-flex align-items-center justify-content-center p-0 border-0 bg-white bg-opacity-25"
                                            style="width: 32px; height: 32px;"
                                            onclick="updateCartQuantity(@Model.Id, 1)">
                                        <i class="bi bi-plus-lg fs-6"></i>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-primary bg-primary-subtle text-primary border-0 w-100 rounded-pill py-2.5 shadow-sm d-flex align-items-center justify-content-center gap-2 fw-semibold"
                                        onclick="updateCartQuantity(@Model.Id, 1)">
                                    <i class="bi bi-bag-plus-fill fs-5"></i>
                                    <span>Add to Cart</span>
                                </button>
                            }
                        </div>

                        <!-- Bottom Action Buttons -->
                        <div class="mt-auto d-flex flex-wrap gap-2 border-top pt-3">

                            <!-- Edit Button (Visible ONLY to Admins & SuperAdmins) -->
                            @if (isAdmin)
                            {
                                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning rounded-pill px-4 flex-fill fw-semibold">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </a>
                            }

                            <!-- Back to List Button -->
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 flex-fill">
                                <i class="bi bi-arrow-left me-1"></i> Back to Products
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const isAuthenticated = @(isAuthenticated.ToString().ToLower());

        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 1500,
            timerProgressBar: true
        });

        function checkAuthOrRedirect() {
            if (!isAuthenticated) {
                Swal.fire({
                    icon: 'info',
                    title: 'Sign In Required',
                    text: 'Please log in to manage your cart and favorites.',
                    showCancelButton: true,
                    confirmButtonText: 'Sign In',
                    confirmButtonColor: '#4f46e5'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '/Accounts/Login';
                    }
                });
                return false;
            }
            return true;
        }

        // 🛒 Add / Update Cart Quantity (Same logic as Index)
        function updateCartQuantity(productId, change) {
            if (!checkAuthOrRedirect()) return;

            const token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: `@Url.Action("AddOrUpdate", "Cart")?productId=${productId}&change=${change}`,
                type: 'POST',
                headers: {
                    "RequestVerificationToken": token
                },
                success: function(response) {
                    const container = $(`#cart-control-container-${productId}`);

                    if (response.removed) {
                        container.html(`
                                    <button type="button"
                                            class="btn btn-primary bg-primary-subtle text-primary border-0 w-100 rounded-pill py-2.5 shadow-sm d-flex align-items-center justify-content-center gap-2 fw-semibold"
                                            onclick="updateCartQuantity(${productId}, 1)">
                                        <i class="bi bi-bag-plus-fill fs-5"></i>
                                        <span>Add to Cart</span>
                                    </button>
                                `);
                        Toast.fire({ icon: 'info', title: 'Item removed from cart' });
                    } else if (response.item) {
                        const newQty = response.item.quantity;

                        container.html(`
                                    <div class="d-flex align-items-center justify-content-between bg-primary text-white rounded-pill px-3 py-2 shadow-sm" style="min-height: 45px;">
                                        <button type="button"
                                                class="btn btn-sm text-white rounded-circle d-flex align-items-center justify-content-center p-0 border-0 bg-white bg-opacity-25"
                                                style="width: 32px; height: 32px;"
                                                onclick="updateCartQuantity(${productId}, -1)">
                                            <i class="bi bi-dash-lg fs-6"></i>
                                        </button>

                                        <span class="fw-bold px-3 fs-6 user-select-none" id="card-qty-${productId}">
                                            ${newQty} <small class="fw-normal text-white-50 ms-1 small">in cart</small>
                                        </span>

                                        <button type="button"
                                                class="btn btn-sm text-white rounded-circle d-flex align-items-center justify-content-center p-0 border-0 bg-white bg-opacity-25"
                                                style="width: 32px; height: 32px;"
                                                onclick="updateCartQuantity(${productId}, 1)">
                                            <i class="bi bi-plus-lg fs-6"></i>
                                        </button>
                                    </div>
                                `);

                        Toast.fire({ icon: 'success', title: 'Cart updated' });
                    }
                },
                error: function(xhr) {
                    if (xhr.status === 401) {
                        checkAuthOrRedirect();
                    } else {
                        Toast.fire({ icon: 'error', title: 'Failed to update cart.' });
                    }
                }
            });
        }

        // ❤️ Toggle Favorite Status
        function toggleFavorite(productId) {
            if (!checkAuthOrRedirect()) return;

            const token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("Add", "Favorite")',
                type: 'POST',
                headers: {
                    "RequestVerificationToken": token
                },
                data: { productId: productId },
                success: function(response) {
                    const icon = $(`#fav-icon-${productId}`);

                    if (response.isFavorite) {
                        icon.removeClass('bi-heart text-secondary').addClass('bi-heart-fill text-danger');
                    } else {
                        icon.removeClass('bi-heart-fill text-danger').addClass('bi-heart text-secondary');
                    }

                    Toast.fire({
                        icon: response.icon || 'success',
                        title: response.message
                    });
                },
                error: function(xhr) {
                    if (xhr.status === 401) {
                        checkAuthOrRedirect();
                    } else {
                        Toast.fire({ icon: 'error', title: 'Failed to update favorite status.' });
                    }
                }
            });
        }
    </script>
}