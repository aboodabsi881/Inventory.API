@using Inventory.Web.ViewModels.Roles
@model RoleVM

@{
    ViewData["Title"] = "Create Role";
}

<div class="row justify-content-center my-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-primary text-white p-4">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-white text-primary rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-shield-plus fs-5"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-0 fw-bold">@Localizer["Create New Role"]</h5>
                        <small class="text-white-50">@Localizer["Define access control roles for system users"]</small>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <form id="createRoleForm" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold text-secondary small">@Localizer["Role Name"]</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0">
                                <i class="bi bi-shield-lock"></i>
                            </span>
                            <input asp-for="Name" class="form-control border-start-0" placeholder="e.g., Manager, Supervisor..." />
                        </div>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                            <i class="bi bi-arrow-left me-1"></i> @Localizer["Back to List"]
                        </a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm fw-semibold">
                            <i class="bi bi-plus-circle me-1"></i> @Localizer["Save Role"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Role/Create.js"></script>
}