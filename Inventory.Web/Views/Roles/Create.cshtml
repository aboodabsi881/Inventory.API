@using Inventory.Web.ViewModels.Roles
@model RoleVM

@{
    ViewData["Title"] = Localizer["Create Role"];
}

<div class="row justify-content-center my-4">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow-sm border rounded-4 overflow-hidden auth-card">

            <!-- Card Header -->
            <div class="card-header bg-primary bg-opacity-10 border-bottom p-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm flex-shrink-0" style="width: 44px; height: 44px;">
                        <i class="bi bi-shield-plus fs-5"></i>
                    </div>
                    <div>
                        <h5 class="header-title mb-0 fw-bold">@Localizer["Create New Role"]</h5>
                        <small class="header-subtitle">@Localizer["Define access control roles for system users"]</small>
                    </div>
                </div>
            </div>

            <!-- Card Body -->
            <div class="card-body p-4">
                <form id="createRoleForm" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <!-- Role Name Input -->
                    <div class="mb-4">
                        <label asp-for="Name" class="form-label fw-semibold small">@Localizer["Role Name"]</label>
                        <div class="input-group">
                            <span class="input-group-text bg-body-secondary text-muted border-end-0 rounded-start-pill ps-3">
                                <i class="bi bi-shield-lock"></i>
                            </span>
                            <input asp-for="Name" class="form-control border-start-0 rounded-end-pill px-3 shadow-none" placeholder="@Localizer["e.g., Manager, Supervisor..."]" />
                        </div>
                        <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top gap-2">
                        <a asp-action="Index" class="btn btn-action-back rounded-pill px-4 shadow-sm fw-semibold">
                            <i class="bi bi-arrow-left me-1"></i> @Localizer["Back to List"]
                        </a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
                            <i class="bi bi-plus-circle me-1"></i> @Localizer["Save Role"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Role/Create.js" asp-append-version="true"></script>
}