@using Inventory.Web.ViewModels.Roles
@model RoleVM

@{
    ViewData["Title"] = Localizer["Edit Role"];
}

<div class="row justify-content-center my-4">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow-sm border rounded-4 overflow-hidden auth-card">

            <!-- Card Header -->
            <div class="card-header bg-warning bg-opacity-10 border-bottom p-3 d-flex align-items-center gap-2">
                <span class="p-2 rounded-3 bg-warning text-dark d-inline-flex align-items-center justify-content-center shadow-sm">
                    <i class="bi bi-pencil-square fs-5"></i>
                </span>
                <h5 class="mb-0 fw-bold header-title">@Localizer["Edit Role"]</h5>
            </div>

            <!-- Card Body -->
            <div class="card-body p-4">
                <form id="editRoleForm" asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <!-- Role Name Input -->
                    <div class="mb-4">
                        <label asp-for="Name" class="form-label fw-semibold small">@Localizer["Role Name"]</label>
                        <div class="input-group">
                            <span class="input-group-text bg-body-secondary text-muted border-end-0 rounded-start-pill ps-3">
                                <i class="bi bi-shield-lock"></i>
                            </span>
                            <input asp-for="Name" class="form-control border-start-0 rounded-end-pill px-3 shadow-none" placeholder="@Localizer["Enter role name"]" />
                        </div>
                        <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top gap-2">
                        <a asp-action="Index" class="btn btn-action-back rounded-pill px-4 shadow-sm fw-semibold">
                            <i class="bi bi-arrow-left me-1"></i> @Localizer["Back to List"]
                        </a>
                        <button type="submit" class="btn btn-warning rounded-pill px-4 shadow-sm fw-bold">
                            <i class="bi bi-save me-1"></i> @Localizer["Update Role"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Role/Edit.js" asp-append-version="true"></script>
}