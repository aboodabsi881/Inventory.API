@using Inventory.Web.ViewModels.Roles
@model IEnumerable<RoleVM>

@{
    ViewData["Title"] = "Roles";
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-shield-lock me-2 text-primary"></i>@Localizer["Application Roles"]
            </h2>
            <p class="text-muted mb-0">@Localizer["Manage system roles and permissions"]</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> @Localizer["Add New Role"]
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="alert alert-secondary text-center m-4">
                    @Localizer["No roles found in the system."]
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4" style="width: 120px;">#ID</th>
                                <th>@Localizer["Role Name"]</th>
                                <th class="text-end pe-4" style="width: 200px;">@Localizer["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var role in Model)
                            {
                                <tr id="role-row-@role.Id">
                                    <td class="ps-4 text-muted fw-semibold">#@role.Id</td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-3 py-2 fs-6">
                                            <i class="bi bi-shield me-1 text-primary"></i>@role.Name
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-sm btn-outline-warning me-1">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteRole(@role.Id, '@role.Name')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        window.RoleConfig = {
            deleteUrl: '@Url.Action("DeleteConfirmed", "Roles")',
            texts: {
                areYouSure: @Json.Serialize(Localizer["Are you sure?"].Value),
                deleteConfirm: @Json.Serialize(Localizer["Do you really want to delete the role"].Value),
                yesDelete: @Json.Serialize(Localizer["Yes, delete it!"].Value),
                deleted: @Json.Serialize(Localizer["Deleted!"].Value),
                oops: @Json.Serialize(Localizer["Oops..."].Value),
                errorDefault: @Json.Serialize(Localizer["Failed to delete role."].Value)
            }
        };
    </script>
    <script src="~/js/Role/Index.js"></script>
}