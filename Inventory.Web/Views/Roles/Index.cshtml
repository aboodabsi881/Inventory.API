@using Inventory.Web.ViewModels.Roles
@model IEnumerable<RoleVM>

@{
    ViewData["Title"] = Localizer["Roles"];
}

@Html.AntiForgeryToken()

<div class="container py-3">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold header-title mb-1 d-flex align-items-center">
                <i class="bi bi-shield-lock me-2 text-primary"></i>@Localizer["Application Roles"]
            </h2>
            <p class="header-subtitle mb-0 small">@Localizer["Manage system roles and permissions"]</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm d-inline-flex align-items-center gap-2">
            <i class="bi bi-plus-circle me-1"></i>
            <span>@Localizer["Add New Role"]</span>
        </a>
    </div>

    <!-- Roles Table Card -->
    <div class="card border shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="alert alert-secondary text-center m-4 rounded-4 border-0">
                    <i class="bi bi-shield-x display-6 d-block mb-2 text-secondary"></i>
                    @Localizer["No roles found in the system."]
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-custom align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4" style="width: 140px;">#ID</th>
                                <th>@Localizer["Role Name"]</th>
                                <th class="text-end pe-4" style="width: 180px;">@Localizer["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var role in Model)
                            {
                                <tr id="role-row-@role.Id">
                                    <td class="ps-4 text-muted fw-semibold">#@role.Id</td>
                                    <td>
                                        <span class="badge category-badge-pill rounded-pill px-3 py-2 fs-6">
                                            <i class="bi bi-shield me-1 text-primary"></i>@role.Name
                                        </span>
                                    </td>
                                    <td class="text-end pe-4 text-nowrap">
                                        <div class="d-inline-flex gap-1">
                                            <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-action-edit btn-sm rounded-pill px-2.5" title="@Localizer["Edit Role"]">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button type="button" class="btn btn-action-delete btn-sm rounded-pill px-2.5" onclick="deleteRole(@role.Id, '@role.Name')" title="@Localizer["Delete Role"]">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.RoleConfig = {
            deleteUrl: '@Url.Action("DeleteConfirmed", "Roles")',
            texts: {
                areYouSure: @Json.Serialize(Localizer["Are you sure?"].Value),
                deleteConfirm: @Json.Serialize(Localizer["Do you really want to delete the role"].Value),
                yesDelete: @Json.Serialize(Localizer["Yes, delete it!"].Value),
                deleted: @Json.Serialize(Localizer["Deleted!"].Value),
                oops: @Json.Serialize(Localizer["Oops..."].Value),
                errorDefault: @Json.Serialize(Localizer["Failed to delete role."].Value)
                    }
        };
    </script>
    <script src="~/js/Role/Index.js" asp-append-version="true"></script>
}