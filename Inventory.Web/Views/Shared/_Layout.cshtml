@using System.Globalization
@using System.Security.Claims

@{
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "0";

    var currentLang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRTL = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    var cssPath = isRTL ? "~/css/styleAr.css" : "~/css/style.css";

    // Select Name based on active culture
    var nameAr = User.FindFirst("NameAr")?.Value;
    var nameEn = User.FindFirst("NameEn")?.Value;
    var displayName = isRTL
        ? (!string.IsNullOrWhiteSpace(nameAr) ? nameAr : (User.Identity?.Name ?? "مستخدم"))
        : (!string.IsNullOrWhiteSpace(nameEn) ? nameEn : (User.Identity?.Name ?? "User"));

    // Generate initial for avatar badge
    var initial = !string.IsNullOrWhiteSpace(displayName) ? displayName.Trim().Substring(0, 1).ToUpper() : "U";
}

<!DOCTYPE html>
<html lang="@currentLang" dir="@(isRTL ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory</title>

    <script>
            (function() {
                if (localStorage.getItem('sidebar_collapsed') === 'true' && window.innerWidth >= 992) {
                    document.documentElement.classList.add('sidebar-collapsed');
                }
            })();
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />

    <!-- Dynamic Compiled SCSS Stylesheet -->
    <link rel="stylesheet" href="@Url.Content(cssPath)" asp-append-version="true" />
</head>
<body>

    <!-- Overlay for Mobile -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- Vertical Sidebar -->
    <aside class="sidebar p-3" id="sidebar">
        <div class="sidebar-header d-flex align-items-center gap-2 pb-3 mb-3 border-bottom px-2">
            <span class="bg-primary text-white rounded-3 p-2 d-inline-flex align-items-center justify-content-center shadow-sm flex-shrink-0" style="width: 40px; height: 40px;">
                <i class="bi bi-box-seam-fill fs-5"></i>
            </span>
            <span class="brand-text tracking-tight fw-bold fs-4 text-dark">@Localizer["Inventory"]</span>
        </div>

        <ul class="nav nav-pills flex-column gap-1 mb-auto">
            <li class="nav-item">
                <a class="nav-link nav-link-item d-flex align-items-center gap-3" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2 fs-5"></i>
                    <span class="link-text">@Localizer["Home"]</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link nav-link-item d-flex align-items-center gap-3" asp-controller="Categories" asp-action="Index">
                    <i class="bi bi-grid-1x2 fs-5"></i>
                    <span class="link-text">@Localizer["Categories"]</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link nav-link-item d-flex align-items-center gap-3" asp-controller="Products" asp-action="Index">
                    <i class="bi bi-boxes fs-5"></i>
                    <span class="link-text">@Localizer["Products"]</span>
                </a>
            </li>

            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Super Admin"))
            {
                <li class="nav-item">
                    <a class="nav-link nav-link-item d-flex align-items-center gap-3" asp-controller="Accounts" asp-action="Index">
                        <i class="bi bi-people fs-5"></i>
                        <span class="link-text">@Localizer["Users"]</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link nav-link-item d-flex align-items-center gap-3" asp-controller="Roles" asp-action="Index">
                        <i class="bi bi-shield-check fs-5"></i>
                        <span class="link-text">@Localizer["Roles"]</span>
                    </a>
                </li>
            }
        </ul>
    </aside>

    <!-- Main Wrapper -->
    <div class="main-wrapper">
        <header class="sticky-top">
            <nav class="navbar glass-header py-2 shadow-sm">
                <div class="container-fluid px-3 px-md-4">
                    <div class="d-flex align-items-center justify-content-between w-100">

                        <button class="btn btn-light border-0 btn-action-icon" type="button" id="sidebarToggle" title="Toggle Sidebar">
                            <i class="bi bi-list fs-4"></i>
                        </button>

                        <div class="d-flex align-items-center gap-2">

                            <!-- Language Dropdown -->
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 dropdown-toggle d-flex align-items-center gap-1 shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-globe me-1"></i>
                                    <span class="fw-semibold text-uppercase">@currentLang</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow p-2 rounded-3">
                                    <li>
                                        <a class="dropdown-item rounded-2 py-1.5" asp-controller="Home" asp-action="ChangeLanguage" asp-route-lang="en" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString">
                                            English (en)
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item rounded-2 py-1.5" asp-controller="Home" asp-action="ChangeLanguage" asp-route-lang="ar" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString">
                                            العربية (ar)
                                        </a>
                                    </li>
                                </ul>
                            </div>

                            <!-- Cart & Favorites -->
                            <a class="btn-action-icon bg-danger-subtle text-danger text-decoration-none" asp-controller="Favorite" asp-action="Index" title="Favorites">
                                <i class="bi bi-heart-fill fs-5"></i>
                            </a>
                            <a class="btn-action-icon bg-primary-subtle text-primary text-decoration-none" asp-controller="Cart" asp-action="Index" title="Shopping Cart">
                                <i class="bi bi-bag-fill fs-5"></i>
                            </a>

                            @if (isAuthenticated)
                            {
                                <!-- Modern User Badge Dropdown -->
                                <div class="dropdown ms-1">
                                    <button class="btn btn-light border rounded-pill d-flex align-items-center gap-2 px-3 py-1.5 shadow-sm dropdown-toggle" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                        <span class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center fw-bold" style="width: 28px; height: 28px; font-size: 0.85rem;">
                                            <i class="bi bi-person-fill"></i>
                                        </span>
                                        <span class="fw-semibold text-dark text-truncate" style="max-width: 140px;">
                                            @(isRTL ? User.FindFirst("NameAr")?.Value : User.FindFirst("NameEn")?.Value)
                                        </span>
                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-custom p-2 mt-2 shadow border-0" aria-labelledby="userMenu" style="min-width: 220px;">
                                        <li class="px-3 py-2 border-bottom mb-2">
                                            <span class="d-block fw-bold text-dark text-truncate">@displayName</span>
                                            <small class="text-muted d-block">@(User.FindFirst(ClaimTypes.Email)?.Value ?? "")</small>
                                        </li>
                                        <li>
                                            <a class="dropdown-item rounded-3 py-2 text-secondary" asp-controller="Accounts" asp-action="PersonalData" asp-route-id="@currentUserId">
                                                <i class="bi bi-person me-2 text-primary"></i> @Localizer["PersonalProfile"]
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item rounded-3 py-2 text-secondary" asp-controller="Accounts" asp-action="ChangePassword" asp-route-id="@currentUserId">
                                                <i class="bi bi-key me-2 text-warning"></i> @Localizer["ChangePassword"]
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item rounded-3 py-2 text-danger" asp-controller="Accounts" asp-action="Logout">
                                                <i class="bi bi-box-arrow-right me-2"></i> @Localizer["SignOut"]
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <a class="btn btn-outline-primary rounded-pill px-3 ms-1" asp-controller="Accounts" asp-action="Login">@Localizer["SignIn"]</a>
                            }

                        </div>
                    </div>
                </div>
            </nav>
        </header>

        <div class="container-fluid px-3 px-md-4 my-3 flex-grow-1">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <footer class="bg-white border-top py-4 mt-auto">
            <div class="container-fluid px-3 px-md-4">
                <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-3 text-muted small">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary-subtle text-primary rounded-pill px-2.5 py-1">v2.5</span>
                        <span>&copy; 2026 <strong>@Localizer["InventoryHub Systems"]</strong>. @Localizer["All rights reserved"]</span>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
            $(document).ready(function() {
                if (localStorage.getItem('sidebar_collapsed') === 'true' && $(window).width() >= 992) {
                    $('body').addClass('sidebar-collapsed');
                }

                $('#sidebarToggle, #sidebarOverlay').on('click', function() {
                    if ($(window).width() < 992) {
                        $('body').toggleClass('sidebar-mobile-open');
                    } else {
                        const isCollapsed = $('body').toggleClass('sidebar-collapsed').hasClass('sidebar-collapsed');
                        $('html').toggleClass('sidebar-collapsed', isCollapsed);
                        localStorage.setItem('sidebar_collapsed', isCollapsed);
                    }
                });

                const currentPath = window.location.pathname.toLowerCase();
                $('.sidebar .nav-link-item').each(function() {
                    const href = $(this).attr('href').toLowerCase();
                    if (currentPath === href || (href !== '/' && currentPath.startsWith(href))) {
                        $(this).addClass('active');
                    }
                });
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>