<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory Management</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- SweetAlert2 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Inventory.Web.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <!-- Navbar -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm py-2">
            <div class="container">
                <!-- Brand -->
                <a class="navbar-brand fw-bold text-primary fs-4 d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="bg-primary text-white rounded p-2 d-inline-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="bi bi-box-seam-fill fs-6"></i>
                    </span>
                    <span>Inventory</span>
                </a>

                <!-- Mobile Toggler -->
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation Links -->
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1 fw-semibold">
                        <li class="nav-item">
                            <a class="nav-link text-secondary px-3 rounded-pill hover-bg" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-secondary px-3 rounded-pill" asp-controller="Categories" asp-action="Index">
                                <i class="bi bi-tags me-1"></i> Categories
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-secondary px-3 rounded-pill" asp-controller="Products" asp-action="Index">
                                <i class="bi bi-boxes me-1"></i> Products
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-secondary px-3 rounded-pill" asp-controller="Roles" asp-action="Index">
                                <i class="bi bi-shield-lock me-1"></i> Roles
                            </a>
                        </li>
                    </ul>

                    <!-- Action Buttons (Favorites & Cart) -->
                    <div class="d-flex align-items-center gap-2">
                        <a class="btn btn-danger-subtle text-danger rounded-circle p-0 d-inline-flex align-items-center justify-content-center"
                           style="width: 40px; height: 40px;"
                           asp-controller="Favorite" asp-action="Index" title="Favorites">
                            <i class="bi bi-heart-fill fs-5"></i>
                        </a>

                        <a class="btn btn-primary-subtle text-primary rounded-circle p-0 d-inline-flex align-items-center justify-content-center position-relative"
                           style="width: 40px; height: 40px;"
                           asp-controller="Cart" asp-action="Index" title="Cart">
                            <i class="bi bi-bag-fill fs-5"></i>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Body -->
    <div class="container my-4 flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="bg-white border-top text-muted py-3 mt-auto">
        <div class="container text-center text-md-between d-flex flex-column flex-md-row align-items-center justify-content-between gap-2">
            <span class="small">&copy; 2026 <strong class="text-dark">Inventory Management System</strong></span>
            <div class="d-flex gap-3 small">
                <a class="text-secondary text-decoration-none" asp-controller="Home" asp-action="Index">Privacy</a>
                <a class="text-secondary text-decoration-none" asp-controller="Home" asp-action="Index">Terms</a>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Auto Active Link Highlighter -->
    <script>
        $(document).ready(function () {
        const currentPath = window.location.pathname.toLowerCase();
        $('.navbar-nav .nav-link').each(function () {
        const href = $(this).attr('href').toLowerCase();
        if (currentPath === href || (href !== '/' && currentPath.startsWith(href))) {
        $(this).addClass('bg-primary-subtle text-primary fw-bold').removeClass('text-secondary');
        }
        });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>